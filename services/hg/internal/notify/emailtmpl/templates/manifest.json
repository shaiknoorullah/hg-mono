{
  "$comment": "GENERATED by `pnpm --filter @hg/emails build` from packages/emails. Do not edit; change the React template and re-export.",
  "templates": [
    {
      "name": "generic",
      "subject": "{{.Title}}",
      "vars": [
        "Title",
        "Body"
      ]
    },
    {
      "name": "email_verification",
      "subject": "Confirm your email for HalalGoes",
      "vars": [
        "ActionURL",
        "ExpiresAt"
      ]
    },
    {
      "name": "password_reset",
      "subject": "Reset your HalalGoes password",
      "vars": [
        "ActionURL",
        "ExpiresAt"
      ]
    },
    {
      "name": "staff_invite",
      "subject": "You're invited to join {{.TeamName}} on HalalGoes",
      "vars": [
        "InviteeName",
        "TeamName",
        "RoleLabel",
        "ActionURL",
        "ExpiresAt"
      ]
    },
    {
      "name": "restaurant_application_approved",
      "subject": "{{.RestaurantName}} is approved on HalalGoes",
      "vars": [
        "RestaurantName",
        "ReasonText",
        "ActionURL"
      ]
    },
    {
      "name": "restaurant_application_changes_requested",
      "subject": "{{.RestaurantName}}: changes needed on your HalalGoes application",
      "vars": [
        "RestaurantName",
        "ReasonText",
        "ActionURL"
      ]
    },
    {
      "name": "restaurant_application_rejected",
      "subject": "Your HalalGoes application for {{.RestaurantName}}",
      "vars": [
        "RestaurantName",
        "ReasonText",
        "ActionURL"
      ]
    },
    {
      "name": "rider_application_approved",
      "subject": "You are approved to deliver with HalalGoes",
      "vars": [
        "FirstName",
        "ReasonText"
      ]
    },
    {
      "name": "rider_application_changes_requested",
      "subject": "Changes needed on your HalalGoes rider application",
      "vars": [
        "FirstName",
        "ReasonText"
      ]
    },
    {
      "name": "rider_application_rejected",
      "subject": "Your HalalGoes rider application",
      "vars": [
        "FirstName",
        "ReasonText"
      ]
    },
    {
      "name": "restaurant_suspended",
      "subject": "{{.RestaurantName}} is suspended on HalalGoes",
      "vars": [
        "RestaurantName",
        "ReasonText",
        "ActionURL"
      ]
    },
    {
      "name": "restaurant_reinstated",
      "subject": "{{.RestaurantName}} is back on HalalGoes",
      "vars": [
        "RestaurantName",
        "ActionURL"
      ]
    },
    {
      "name": "rider_suspended",
      "subject": "Your HalalGoes rider account is paused",
      "vars": [
        "FirstName",
        "ReasonText"
      ]
    },
    {
      "name": "rider_reinstated",
      "subject": "You can deliver with HalalGoes again",
      "vars": [
        "FirstName"
      ]
    },
    {
      "name": "payout_sent",
      "subject": "HalalGoes sent you {{.Amount}}",
      "vars": [
        "PayeeName",
        "Amount",
        "PeriodText",
        "SentAt"
      ]
    },
    {
      "name": "certificate_renewal_reminder",
      "subject": "Your halal certificate expires {{.TimeLeft}}",
      "vars": [
        "RestaurantName",
        "IssuerName",
        "ExpiresOn",
        "TimeLeft",
        "ActionURL"
      ]
    },
    {
      "name": "certificate_lapsed",
      "subject": "{{.RestaurantName}} is hidden until your halal certificate is renewed",
      "vars": [
        "RestaurantName",
        "IssuerName",
        "ExpiredOn",
        "ActionURL"
      ]
    }
  ]
}
