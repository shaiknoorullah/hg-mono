# The build context is services/hg. Keep it to source and module files.
.git
.gitignore
*.md
bin/
tmp/
**/__pycache__/
*.pyc
.env
.env.*
!.env.example
# Locally built binaries (see .gitignore): the image builds its own.
hg
seedpw
seedtotp
totpnow
cmd/hg/hg
cmd/seedpw/seedpw
cmd/seedtotp/seedtotp
cmd/totpnow/totpnow
*.test
*.err
