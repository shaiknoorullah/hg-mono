{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Halal Goes design tokens. W3C DTCG draft format. Single source of truth for the customer app (Expo/RN), rider app (Expo/RN), restaurant web and admin web. Consumed by Style Dictionary -> NativeWind preset + CSS custom properties + typed TS. See docs/design/01-foundations.md. Colours marked HS-derived sit in the colour family HungerStation is documented to use; NO hex here is sampled from HungerStation (see 01-foundations.md 1.2).",

  "color": {
    "$type": "color",

    "brand": {
      "$description": "Saffron. HS-derived. Brand + action colour. Steps 500/600 are FILLS ONLY -- brand as text on light must use step 800.",
      "50":  { "$value": "#FFF9E6" },
      "100": { "$value": "#FFF0BF" },
      "200": { "$value": "#FFE694" },
      "300": { "$value": "#FFDB69", "$description": "Brand accent on Midnight chrome (14.23:1 on accent.950)." },
      "400": { "$value": "#FFD147", "$description": "Brand text in dark theme (12.05:1 on surface.subtle dark)." },
      "500": { "$value": "#FFC220", "$description": "Brand base. Primary button fill. Label on it MUST be text.onBrand (10.58:1); white is 1.62:1 and is banned." },
      "600": { "$value": "#DFA400" },
      "700": { "$value": "#A87C00" },
      "800": { "$value": "#7A5800", "$description": "Brand text on light surfaces (6.51:1)." },
      "900": { "$value": "#513B00" },
      "950": { "$value": "#2B1F00" }
    },

    "accent": {
      "$description": "Midnight. Ours. Authority / operational chrome. Deliberately distinct from info blue (brighter, cyan-shifted) and from the warm neutrals.",
      "50":  { "$value": "#EEF2F9" },
      "100": { "$value": "#D6DFEE" },
      "200": { "$value": "#B0C0DC" },
      "300": { "$value": "#8098C4" },
      "400": { "$value": "#5471A8" },
      "500": { "$value": "#34528C", "$description": "7.69:1 with white." },
      "600": { "$value": "#24406F", "$description": "Secondary button fill; restaurant/admin AppBar. 10.30:1 with white." },
      "700": { "$value": "#1B3157" },
      "800": { "$value": "#142542" },
      "900": { "$value": "#0E1A2F", "$description": "Rider AppBar / restaurant queue header." },
      "950": { "$value": "#080F1C", "$description": "Rider full-screen offer chrome. 16.99:1 with neutral.100." }
    },

    "neutral": {
      "$description": "Sand. Ours. Warm-tinted greys (~hue 40, very low chroma).",
      "0":    { "$value": "#FFFFFF" },
      "50":   { "$value": "#FAF9F7" },
      "100":  { "$value": "#F3F1ED" },
      "200":  { "$value": "#E7E3DC" },
      "300":  { "$value": "#D5CFC5" },
      "400":  { "$value": "#B6AEA1" },
      "500":  { "$value": "#948C7E", "$description": "Minimum colour that reaches 3:1 on white -- the floor for interactive borders." },
      "600":  { "$value": "#6E6658" },
      "700":  { "$value": "#4A443B" },
      "800":  { "$value": "#332E28" },
      "900":  { "$value": "#1F1B17" },
      "950":  { "$value": "#12100D" },
      "1000": { "$value": "#000000", "$description": "Shadow colour only. Never a text or surface colour." }
    },

    "success": {
      "$description": "Emerald. Ours. TINT-ONLY ROLE -- see RULE H-1: no filled green backgrounds outside color.halal.*.",
      "50":  { "$value": "#E7F7F0" },
      "100": { "$value": "#C7EEDE" },
      "300": { "$value": "#4FC79A", "$description": "Dark-theme success text (8.31:1)." },
      "500": { "$value": "#0E9F6E", "$description": "Icon / 2px accent border only (3.39:1 on white). Not a fill." },
      "600": { "$value": "#067A55", "$description": "Success text on light (5.35:1)." },
      "700": { "$value": "#05603F", "$description": "Text on success.50 tint (6.89:1)." },
      "800": { "$value": "#04492F" },
      "900": { "$value": "#03301F" }
    },

    "warning": {
      "$description": "Ember. Ours. ORANGE (~hue 28), never yellow -- brand yellow is spent on CTAs. 3.23:1 separation from brand.500.",
      "50":  { "$value": "#FEF1E7" },
      "100": { "$value": "#FDDDC4" },
      "300": { "$value": "#F59A5C", "$description": "Dark-theme warning text (8.05:1)." },
      "500": { "$value": "#E8690F", "$description": "Icon only. As a fill with white it is 3.25:1 -- use 600." },
      "600": { "$value": "#B84A08", "$description": "Warning fill with white label (5.22:1) and warning text on light (5.22:1)." },
      "700": { "$value": "#8F3A06", "$description": "Text on warning.50 tint (6.83:1)." },
      "900": { "$value": "#52210C" }
    },

    "danger": {
      "$description": "Ours. NEVER used by any halal state -- see RULE H-3.",
      "50":  { "$value": "#FDECEA" },
      "100": { "$value": "#FBD5D1" },
      "300": { "$value": "#F08C82", "$description": "Dark-theme danger text (7.32:1)." },
      "500": { "$value": "#D92D20", "$description": "Danger fill with white label (4.83:1)." },
      "600": { "$value": "#B42318", "$description": "Danger text on light (6.57:1)." },
      "700": { "$value": "#912018", "$description": "Text on danger.50 tint (7.58:1)." },
      "900": { "$value": "#55110C" }
    },

    "info": {
      "$description": "Ours. Also the base of the focus ring.",
      "50":  { "$value": "#E9F1FE" },
      "100": { "$value": "#CBDFFC" },
      "300": { "$value": "#6FA9F2", "$description": "Dark-theme info text and dark focus ring (7.19:1)." },
      "500": { "$value": "#0B72E7", "$description": "Info fill with white label (4.59:1); light focus ring (4.59:1 on white)." },
      "600": { "$value": "#0959B8", "$description": "Info text on light (6.70:1)." },
      "700": { "$value": "#07458F", "$description": "Text on info.50 tint (8.19:1)." },
      "900": { "$value": "#04264F" }
    },

    "halal": {
      "$description": "RESERVED NAMESPACE. Importable ONLY by HalalBadge, HalalCertificationPanel, admin HalalChecklist, and the registered map-pin exception. RULE H-1: halal.certified.seal is the only filled solid green surface in the system. RULE H-2: a halal state is a composite {fill, ring, glyph, label}, never a bare colour. RULE H-3: no halal state may use the danger ramp -- red would read as a religious ruling the platform does not make.",

      "certified": {
        "$description": "halal_display_state = CERTIFIED. Filled bottle-green seal, brass outer ring, solid shield glyph, label 'Halal certified' (exact string, C-12 R7).",
        "seal":        { "$value": "#04482A", "$description": "Light. 10.68:1 with white label; 10.68:1 boundary against white surface." },
        "sealPressed": { "$value": "#033520" },
        "sealDark":    { "$value": "#0F7A46", "$description": "Dark theme. 5.39:1 with white label; 3.24:1 against dark surface." },
        "onSeal":      { "$value": "#FFFFFF" },
        "ring":        { "$value": "#D4A72C", "$description": "Brass. 1.5px outer ring, 4.76:1 against seal. Decorative -- the informational boundary is seal-vs-surface. The single point where brand warmth touches the verification register." },
        "ringDark":    { "$value": "#E3BE4A", "$description": "3.01:1 against sealDark." },
        "tint":        { "$value": "#E4F0E9", "$description": "Certification panel background." },
        "tintText":    { "$value": "#04482A", "$description": "9.13:1 on tint." },
        "tintBorder":  { "$value": "#9DC4AE" },
        "tintDark":     { "$value": "#08261A" },
        "tintTextDark": { "$value": "#7BE0A8", "$description": "10.03:1 on tintDark." }
      },

      "expiring": {
        "$description": "halal_display_state = EXPIRING_SOON. The CARD BADGE IS IDENTICAL TO CERTIFIED (C-12). These tokens style ONLY the renewal note row inside HalalCertificationPanel. Brass-ochre, deliberately NOT the semantic warning orange: the certificate is valid today; this is a transparency signal, not an alert.",
        "text":     { "$value": "#7A5600", "$description": "5.91:1 on tint." },
        "icon":     { "$value": "#8A6100", "$description": "4.93:1 on tint. Clock glyph." },
        "tint":     { "$value": "#FBF1D8" },
        "border":   { "$value": "#D9BE7A" },
        "textDark": { "$value": "#E8C463", "$description": "9.56:1 on tintDark." },
        "tintDark": { "$value": "#2A2008" }
      },

      "expired": {
        "$description": "halal_display_state = EXPIRED. Cool slate -- NOT the warm neutral ramp, so it reads as a certification state rather than as disabled chrome; and NOT red, per RULE H-3. Says 'the platform's knowledge has lapsed', not 'this food is not halal'. Customer surfaces never see this state (C-12 R1 hides the restaurant entirely); it appears on restaurant, admin and rider surfaces.",
        "seal":     { "$value": "#4E5862", "$description": "7.25:1 with white label." },
        "sealDark": { "$value": "#7C8794", "$description": "5.20:1 against dark base." },
        "onSeal":   { "$value": "#FFFFFF" },
        "tint":     { "$value": "#EDEFF1" },
        "text":     { "$value": "#39424B", "$description": "8.87:1 on tint." },
        "border":   { "$value": "#B9C0C7" },
        "tintDark": { "$value": "#1B1F24" },
        "textDark": { "$value": "#AEB6BF", "$description": "8.08:1 on tintDark." }
      },

      "unverified": {
        "$description": "halal_display_state = UNVERIFIED. CUSTOMER SURFACES RENDER NOTHING (C-12 R4: no badge, and a client error is logged if halal_display_state is absent -- there is no 'assume certified'). These tokens exist for restaurant/admin onboarding surfaces only. Transparent fill + dashed border + dashed shield glyph.",
        "fill":       { "$value": "#00000000", "$description": "Fully transparent." },
        "border":     { "$value": "#B6AEA1", "$description": "1.5px dashed." },
        "text":       { "$value": "#6E6658", "$description": "6.71:1 on white." },
        "borderDark": { "$value": "#4A443B" },
        "textDark":   { "$value": "#B6AEA1" }
      }
    },

    "viz": {
      "$description": "Admin chart categoricals. Avoids all reserved meanings.",
      "1": { "$value": "#24406F" },
      "2": { "$value": "#0B72E7" },
      "3": { "$value": "#7A5800" },
      "4": { "$value": "#8E4EC6" },
      "5": { "$value": "#B84A08" },
      "6": { "$value": "#4E5862" },
      "7": { "$value": "#0F766E" },
      "8": { "$value": "#B42318" }
    },

    "map": {
      "routeActive":    { "$value": "#0B72E7", "$description": "5px stroke with 2px white casing." },
      "routeTravelled": { "$value": "#948C7E" },
      "pinRestaurant":  { "$value": "#FFC220" },
      "pinCustomer":    { "$value": "#24406F" },
      "pinRider":       { "$value": "#04482A", "$description": "REGISTERED EXCEPTION to the halal namespace lint (L-3/L-4). A rider pin is a Halal Goes rider, carries no shield, and makes no certification claim." },
      "geofenceStroke": { "$value": "#0B72E7" },
      "geofenceFill":   { "$value": "#0B72E71F" }
    }
  },

  "theme": {
    "$type": "color",
    "$description": "ROLES. Components consume these, never the numbered ramp steps (lint L-2). Each role carries a light and a dark value.",

    "light": {
      "surface": {
        "base":     { "$value": "{color.neutral.0}" },
        "sunken":   { "$value": "{color.neutral.50}" },
        "subtle":   { "$value": "{color.neutral.100}" },
        "raised":   { "$value": "{color.neutral.0}" },
        "inverse":  { "$value": "{color.neutral.900}" },
        "chrome":   { "$value": "{color.accent.600}", "$description": "operational/field themes only" },
        "scrim":    { "$value": "#1F1B17B8" }
      },
      "text": {
        "primary":     { "$value": "{color.neutral.900}", "$description": "17.11:1" },
        "secondary":   { "$value": "{color.neutral.700}", "$description": "9.63:1" },
        "tertiary":    { "$value": "{color.neutral.600}", "$description": "5.67:1" },
        "placeholder": { "$value": "{color.neutral.500}", "$description": "3.33:1 -- placeholder only, never the sole label" },
        "disabled":    { "$value": "{color.neutral.400}", "$description": "2.20:1. WCAG 1.4.3 exempts disabled controls; disabled is ALSO signalled by 60% opacity + aria-disabled." },
        "onBrand":     { "$value": "{color.neutral.900}", "$description": "10.58:1 on brand.500. The only permitted label colour on brand fill." },
        "onInverse":   { "$value": "{color.neutral.100}" },
        "onAccent":    { "$value": "{color.neutral.0}" },
        "link":        { "$value": "{color.info.600}" }
      },
      "border": {
        "decorative":  { "$value": "{color.neutral.200}", "$description": "1.28:1. Decorative only -- never bounds an interactive control." },
        "interactive": { "$value": "{color.neutral.500}", "$description": "3.33:1. Required for input/select/checkbox borders (WCAG 1.4.11)." },
        "strong":      { "$value": "{color.neutral.700}" },
        "brand":       { "$value": "{color.brand.600}" }
      },
      "focus": {
        "ring":     { "$value": "{color.info.500}", "$description": "3px outer ring. 4.59:1 on white." },
        "offset":   { "$value": "{color.neutral.0}", "$description": "2px offset in the page colour, drawn between the control and the ring." },
        "onColor":  { "$value": "{color.neutral.0}", "$description": "Ring flips to this on coloured containers where info.500 falls below 3:1 (brand 2.84, halal 2.33, danger 1.05, accent 2.24)." }
      },
      "state": {
        "hoverOverlay":   { "$value": "#1F1B170F" },
        "pressedOverlay": { "$value": "#1F1B171F" },
        "selectedTint":   { "$value": "{color.brand.50}" },
        "disabledOpacity": { "$type": "number", "$value": 0.6 }
      }
    },

    "dark": {
      "surface": {
        "base":     { "$value": "{color.neutral.950}" },
        "sunken":   { "$value": "{color.neutral.1000}" },
        "subtle":   { "$value": "{color.neutral.900}" },
        "raised":   { "$value": "{color.neutral.800}", "$description": "Dark elevation is a SURFACE STEP, not a shadow -- black shadow on near-black is invisible." },
        "inverse":  { "$value": "{color.neutral.100}" },
        "chrome":   { "$value": "{color.accent.900}" },
        "scrim":    { "$value": "#000000C4" }
      },
      "text": {
        "primary":     { "$value": "{color.neutral.100}", "$description": "15.51:1 on surface.subtle" },
        "secondary":   { "$value": "{color.neutral.400}", "$description": "7.96:1" },
        "tertiary":    { "$value": "{color.neutral.500}", "$description": "5.26:1" },
        "placeholder": { "$value": "{color.neutral.600}" },
        "disabled":    { "$value": "{color.neutral.700}" },
        "onBrand":     { "$value": "{color.neutral.950}", "$description": "11.75:1 on brand.500" },
        "onInverse":   { "$value": "{color.neutral.900}" },
        "onAccent":    { "$value": "{color.neutral.0}" },
        "link":        { "$value": "{color.info.300}" }
      },
      "border": {
        "decorative":  { "$value": "{color.neutral.800}" },
        "interactive": { "$value": "{color.neutral.600}", "$description": "3.09:1 on surface.subtle. neutral.700 is only 1.82:1 and fails 1.4.11." },
        "strong":      { "$value": "{color.neutral.500}" },
        "brand":       { "$value": "{color.brand.400}" }
      },
      "focus": {
        "ring":    { "$value": "{color.info.300}" },
        "offset":  { "$value": "{color.neutral.950}" },
        "onColor": { "$value": "{color.neutral.0}" }
      },
      "state": {
        "hoverOverlay":   { "$value": "#FFFFFF14" },
        "pressedOverlay": { "$value": "#FFFFFF29" },
        "selectedTint":   { "$value": "{color.brand.950}" },
        "disabledOpacity": { "$type": "number", "$value": 0.5 }
      }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "ui":   { "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "Noto Sans", "sans-serif"], "$description": "RN registers 'Inter_400Regular'..'Inter_700Bold' via expo-font; the chain applies on web only. RN has NO fallback chain -- a startup assertion must fail loudly if the family is unresolvable." },
      "rtl":  { "$value": ["IBM Plex Sans Arabic", "Noto Sans Arabic", "Geeza Pro", "Segoe UI", "Tahoma", "sans-serif"], "$description": "Not shipped at launch (en-CA only). Pre-selected so RTL is a token swap, not a redesign." },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "Liberation Mono", "monospace"], "$description": "Admin only: IDs, UUIDv7, certificate numbers, audit payloads." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },
    "numeric": {
      "$type": "string",
      "tabular": { "$value": "tabular-nums", "$description": "MANDATORY on Price, Countdown, StatusTimeline, DataTable, Rating. Web: font-variant-numeric. RN: style.fontVariant=['tabular-nums'] (iOS + Android API 26+); below that Countdown uses fixed-width layout." }
    }
  },

  "typography": {
    "$type": "typography",
    "$description": "lineHeight carries BOTH the unitless multiplier (web) and the resolved px (RN, which requires absolute lineHeight). If a fontSize changes, the resolved px must be regenerated.",

    "display.lg":  { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 36, "fontWeight": 700, "lineHeight": 1.15, "lineHeightPx": 42, "letterSpacing": "-0.02em" }, "$description": "Rider offer earnings; admin hero metric." },
    "display.md":  { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 30, "fontWeight": 700, "lineHeight": 1.2,  "lineHeightPx": 36, "letterSpacing": "-0.02em" }, "$description": "Empty-state headline; checkout total." },
    "heading.xl":  { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 24, "fontWeight": 700, "lineHeight": 1.25, "lineHeightPx": 30, "letterSpacing": "-0.01em" } },
    "heading.lg":  { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 20, "fontWeight": 600, "lineHeight": 1.3,  "lineHeightPx": 26, "letterSpacing": "-0.01em" } },
    "heading.md":  { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 18, "fontWeight": 600, "lineHeight": 1.35, "lineHeightPx": 24, "letterSpacing": "0" } },
    "heading.sm":  { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 16, "fontWeight": 600, "lineHeight": 1.4,  "lineHeightPx": 22, "letterSpacing": "0" } },
    "body.lg":     { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 17, "fontWeight": 400, "lineHeight": 1.5,  "lineHeightPx": 26, "letterSpacing": "0" }, "$description": "Rider app default body." },
    "body.md":     { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 15, "fontWeight": 400, "lineHeight": 1.5,  "lineHeightPx": 22, "letterSpacing": "0" }, "$description": "Default body." },
    "body.sm":     { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 13, "fontWeight": 400, "lineHeight": 1.45, "lineHeightPx": 19, "letterSpacing": "0" }, "$description": "Floor for any text a customer must read to decide." },
    "label.lg":    { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 15, "fontWeight": 600, "lineHeight": 1.2,  "lineHeightPx": 18, "letterSpacing": "0" } },
    "label.md":    { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 13, "fontWeight": 600, "lineHeight": 1.2,  "lineHeightPx": 16, "letterSpacing": "0.01em" } },
    "label.sm":    { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 11, "fontWeight": 600, "lineHeight": 1.2,  "lineHeightPx": 14, "letterSpacing": "0.04em" }, "$description": "Badge and seal label. 'Halal certified' is sentence case at this token -- NOT all-caps (screen readers may spell out all-caps)." },
    "caption":     { "$value": { "fontFamily": "{font.family.ui}", "fontSize": 12, "fontWeight": 400, "lineHeight": 1.4,  "lineHeightPx": 17, "letterSpacing": "0" }, "$description": "Timestamps; the standing line 'Certification verified by Halal Goes on {date}. Halal Goes does not itself certify food.'" },
    "mono.md":     { "$value": { "fontFamily": "{font.family.mono}", "fontSize": 13, "fontWeight": 400, "lineHeight": 1.45, "lineHeightPx": 19, "letterSpacing": "0" } },
    "mono.sm":     { "$value": { "fontFamily": "{font.family.mono}", "fontSize": 11, "fontWeight": 400, "lineHeight": 1.4,  "lineHeightPx": 15, "letterSpacing": "0" } }
  },

  "space": {
    "$type": "dimension",
    "0":  { "$value": 0 },
    "1":  { "$value": 4 },
    "2":  { "$value": 8 },
    "3":  { "$value": 12 },
    "4":  { "$value": 16, "$description": "Default gutter." },
    "5":  { "$value": 20 },
    "6":  { "$value": 24 },
    "8":  { "$value": 32 },
    "10": { "$value": 40 },
    "12": { "$value": 48 },
    "16": { "$value": 64 },
    "20": { "$value": 80 },
    "24": { "$value": 96 }
  },

  "density": {
    "$type": "dimension",
    "$description": "Set once at the theme root. Components read density.*; they never hard-code 16.",
    "comfortable": { "rowHeight": { "$value": 64 }, "cardPadding": { "$value": 16 }, "gutter": { "$value": 16 } },
    "compact":     { "rowHeight": { "$value": 44 }, "cardPadding": { "$value": 12 }, "gutter": { "$value": 12 } },
    "roomy":       { "rowHeight": { "$value": 72 }, "cardPadding": { "$value": 20 }, "gutter": { "$value": 20 } }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": 0 },
    "xs":   { "$value": 4 },
    "sm":   { "$value": 8 },
    "md":   { "$value": 12, "$description": "Default. Also the halal seal -- a softly-squared plate reads as a seal; radius.full would read as a tag." },
    "lg":   { "$value": 16 },
    "xl":   { "$value": 20 },
    "2xl":  { "$value": 24 },
    "full": { "$value": 9999 }
  },

  "elevation": {
    "$description": "Dual-form. Light themes use shadow; DARK THEMES IGNORE shadow and use surfaceStep instead.",
    "0": { "$value": { "web": "none", "rn": null, "android": 0, "surfaceStep": "{theme.dark.surface.base}" } },
    "1": { "$value": { "web": "0 1px 2px rgba(0,0,0,.06), 0 1px 3px rgba(0,0,0,.08)",   "rn": { "shadowColor": "#000000", "shadowOffset": { "width": 0, "height": 1 }, "shadowOpacity": 0.08, "shadowRadius": 3  }, "android": 1,  "surfaceStep": "{theme.dark.surface.subtle}" } },
    "2": { "$value": { "web": "0 2px 4px rgba(0,0,0,.06), 0 4px 8px rgba(0,0,0,.08)",   "rn": { "shadowColor": "#000000", "shadowOffset": { "width": 0, "height": 2 }, "shadowOpacity": 0.10, "shadowRadius": 6  }, "android": 3,  "surfaceStep": "{theme.dark.surface.subtle}" } },
    "3": { "$value": { "web": "0 4px 8px rgba(0,0,0,.08), 0 8px 16px rgba(0,0,0,.10)",  "rn": { "shadowColor": "#000000", "shadowOffset": { "width": 0, "height": 4 }, "shadowOpacity": 0.12, "shadowRadius": 12 }, "android": 6,  "surfaceStep": "{theme.dark.surface.raised}", "darkHairline": "{theme.dark.border.decorative}" } },
    "4": { "$value": { "web": "0 8px 16px rgba(0,0,0,.10), 0 16px 32px rgba(0,0,0,.12)","rn": { "shadowColor": "#000000", "shadowOffset": { "width": 0, "height": 8 }, "shadowOpacity": 0.16, "shadowRadius": 24 }, "android": 12, "surfaceStep": "{theme.dark.surface.raised}", "darkHairline": "{theme.dark.border.decorative}" } },
    "sticky": { "$value": { "web": "0 -2px 8px rgba(0,0,0,.08)", "rn": { "shadowColor": "#000000", "shadowOffset": { "width": 0, "height": -2 }, "shadowOpacity": 0.10, "shadowRadius": 8 }, "android": 8, "surfaceStep": "{theme.dark.surface.raised}" }, "$description": "Floating cart bar; sticky checkout footer. Shadow points UP." }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "instant":    { "$value": "75ms" },
      "fast":       { "$value": "120ms" },
      "base":       { "$value": "180ms" },
      "moderate":   { "$value": "240ms" },
      "slow":       { "$value": "320ms" },
      "deliberate": { "$value": "480ms", "$description": "StatusTimeline step advance; halal seal first reveal." }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":   { "$value": [0.2, 0, 0, 1] },
      "decelerate": { "$value": [0, 0, 0, 1] },
      "accelerate": { "$value": [0.3, 0, 1, 1] },
      "emphasized": { "$value": [0.2, 0, 0, 1.05] },
      "linear":     { "$value": [0, 0, 1, 1], "$description": "COUNTDOWNS AND PROGRESS ONLY. Easing a deadline misrepresents remaining time." }
    },
    "spring": {
      "snappy": { "$value": { "damping": 22, "stiffness": 320, "mass": 1 } },
      "smooth": { "$value": { "damping": 26, "stiffness": 200, "mass": 1 } },
      "gentle": { "$value": { "damping": 30, "stiffness": 140, "mass": 1 } }
    },
    "reducedMotion": {
      "$description": "prefers-reduced-motion / AccessibilityInfo.isReduceMotionEnabled collapses all durations to 0 and replaces slide/scale with cross-fade at duration.fast. Countdown NUMERALS keep updating -- they are information, not decoration."
    }
  },

  "icon": {
    "$type": "dimension",
    "$description": "Lucide (ISC). The halal shield is a BESPOKE inline SVG, never lucide/shield-check and never a font glyph -- a font glyph fails silently and would render a blank certification badge.",
    "sm":  { "$value": 16 },
    "md":  { "$value": 20 },
    "lg":  { "$value": 24 },
    "xl":  { "$value": 32 },
    "2xl": { "$value": 48 },
    "strokeDefault": { "$value": 2 },
    "strokeSmall":   { "$value": 1.75 }
  },

  "target": {
    "$type": "dimension",
    "$description": "Minimum hit areas. See 04-accessibility.md.",
    "min":       { "$value": 44, "$description": "WCAG 2.2 AAA / Apple HIG. Absolute floor everywhere." },
    "field":     { "$value": 56, "$description": "Rider app minimum -- gloved thumb, moving vehicle stationary, one-handed." },
    "criticalField": { "$value": 72, "$description": "Rider Accept / Decline; restaurant Accept order. Irreversible-under-time-pressure actions." },
    "spacing":   { "$value": 8, "$description": "Minimum gap between adjacent targets." }
  },

  "zIndex": {
    "$type": "number",
    "base": { "$value": 0 },
    "sticky": { "$value": 100 },
    "appBar": { "$value": 200 },
    "bottomNav": { "$value": 200 },
    "dropdown": { "$value": 300 },
    "sheet": { "$value": 400 },
    "modal": { "$value": 500 },
    "toast": { "$value": 600 },
    "offerSheet": { "$value": 700, "$description": "Rider offer sheet outranks everything. It is non-dismissible until server expires_at (D-14)." }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "Web surfaces only. The RN apps are phone-first and use density, not breakpoints.",
    "sm": { "$value": 640 },
    "md": { "$value": 768 },
    "lg": { "$value": 1024, "$description": "Restaurant queue switches to 4 columns at/above this." },
    "xl": { "$value": 1280 },
    "2xl": { "$value": 1536 }
  },

  "_pairs": {
    "$description": "Machine-checked contrast pairs. contrast.check.mjs walks this list in CI; anything below `min` is a BUILD FAILURE, not a warning. `note` records documented exemptions.",
    "$type": "other",
    "$value": [
      { "fg": "{theme.light.text.primary}",   "bg": "{theme.light.surface.base}", "min": 7.0,  "actual": 17.11 },
      { "fg": "{theme.light.text.secondary}", "bg": "{theme.light.surface.base}", "min": 4.5,  "actual": 9.63 },
      { "fg": "{theme.light.text.tertiary}",  "bg": "{theme.light.surface.base}", "min": 4.5,  "actual": 5.67 },
      { "fg": "{theme.light.text.onBrand}",   "bg": "{color.brand.500}",          "min": 7.0,  "actual": 10.58 },
      { "fg": "{color.brand.800}",            "bg": "{theme.light.surface.base}", "min": 4.5,  "actual": 6.51 },
      { "fg": "{theme.light.border.interactive}", "bg": "{theme.light.surface.base}", "min": 3.0, "actual": 3.33 },
      { "fg": "{theme.light.focus.ring}",     "bg": "{theme.light.surface.base}", "min": 3.0,  "actual": 4.59 },

      { "fg": "{color.halal.certified.onSeal}",   "bg": "{color.halal.certified.seal}",     "min": 7.0, "actual": 10.68, "note": "The seal targets AAA. This is the product's differentiator." },
      { "fg": "{color.halal.certified.seal}",     "bg": "{theme.light.surface.base}",       "min": 3.0, "actual": 10.68, "note": "Seal boundary (1.4.11)." },
      { "fg": "{color.halal.certified.ring}",     "bg": "{color.halal.certified.seal}",     "min": 3.0, "actual": 4.76 },
      { "fg": "{color.halal.certified.tintText}", "bg": "{color.halal.certified.tint}",     "min": 7.0, "actual": 9.13 },
      { "fg": "{color.halal.certified.onSeal}",   "bg": "{color.halal.certified.sealDark}", "min": 4.5, "actual": 5.39, "note": "AA not AAA. A green dark enough for AAA-on-white is invisible on a #12100D page; dark seals compensate with a full 1.5px brass ring plus a 1px outer separator." },
      { "fg": "{color.halal.certified.tintTextDark}", "bg": "{color.halal.certified.tintDark}", "min": 7.0, "actual": 10.03 },
      { "fg": "{color.halal.expiring.text}",      "bg": "{color.halal.expiring.tint}",      "min": 4.5, "actual": 5.91 },
      { "fg": "{color.halal.expiring.icon}",      "bg": "{color.halal.expiring.tint}",      "min": 4.5, "actual": 4.93 },
      { "fg": "{color.halal.expiring.textDark}",  "bg": "{color.halal.expiring.tintDark}",  "min": 7.0, "actual": 9.56 },
      { "fg": "{color.halal.expired.onSeal}",     "bg": "{color.halal.expired.seal}",       "min": 4.5, "actual": 7.25 },
      { "fg": "{color.halal.expired.text}",       "bg": "{color.halal.expired.tint}",       "min": 4.5, "actual": 8.87 },
      { "fg": "{color.halal.expired.textDark}",   "bg": "{color.halal.expired.tintDark}",   "min": 4.5, "actual": 8.08 },
      { "fg": "{color.halal.unverified.text}",    "bg": "{theme.light.surface.base}",       "min": 4.5, "actual": 6.71 },

      { "fg": "{color.neutral.0}", "bg": "{color.danger.500}",  "min": 4.5, "actual": 4.83 },
      { "fg": "{color.neutral.0}", "bg": "{color.warning.600}", "min": 4.5, "actual": 5.22 },
      { "fg": "{color.neutral.0}", "bg": "{color.info.500}",    "min": 4.5, "actual": 4.59 },
      { "fg": "{color.neutral.0}", "bg": "{color.accent.600}",  "min": 4.5, "actual": 10.30 },
      { "fg": "{color.success.700}", "bg": "{color.success.50}",  "min": 4.5, "actual": 6.89 },
      { "fg": "{color.warning.700}", "bg": "{color.warning.50}",  "min": 4.5, "actual": 6.83 },
      { "fg": "{color.danger.700}",  "bg": "{color.danger.50}",   "min": 4.5, "actual": 7.58 },
      { "fg": "{color.info.700}",    "bg": "{color.info.50}",     "min": 4.5, "actual": 8.19 },

      { "fg": "{theme.dark.text.primary}",   "bg": "{theme.dark.surface.subtle}", "min": 7.0, "actual": 15.51 },
      { "fg": "{theme.dark.text.secondary}", "bg": "{theme.dark.surface.subtle}", "min": 4.5, "actual": 7.96 },
      { "fg": "{theme.dark.border.interactive}", "bg": "{theme.dark.surface.subtle}", "min": 3.0, "actual": 3.09 },
