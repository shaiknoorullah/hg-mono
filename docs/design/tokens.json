      { "fg": "{color.neutral.100}", "bg": "{color.accent.950}", "min": 7.0, "actual": 16.99, "note": "Rider offer chrome -- field theme requires >=7:1 for ALL body text." },
      { "fg": "{color.brand.300}",   "bg": "{color.accent.950}", "min": 7.0, "actual": 14.23 },

      { "fg": "{theme.light.text.disabled}",   "bg": "{theme.light.surface.base}", "min": 0, "actual": 2.20, "note": "EXEMPT: WCAG 1.4.3 excludes disabled controls. Also signalled by 60% opacity + aria-disabled." },
      { "fg": "{theme.light.border.decorative}","bg": "{theme.light.surface.base}", "min": 0, "actual": 1.28, "note": "EXEMPT: decorative dividers only; never bounds an interactive control." },
      { "fg": "{color.halal.certified.ring}",  "bg": "{theme.light.surface.base}", "min": 0, "actual": 2.24, "note": "EXEMPT: decorative. The seal's informational boundary is seal-vs-surface at 10.68:1." }
    ]
  },

  "_separation": {
    "$description": "Pairs that must be DISTINGUISHABLE from one another (not fg/bg). Documents why RULE H-1 exists.",
    "$type": "other",
    "$value": [
      { "a": "{color.halal.certified.seal}", "b": "{color.success.600}", "measured": 2.00, "verdict": "CANNOT SEPARATE BY LUMINANCE. No two greens are both individually accessible and 3:1 apart. Separation is by FORM: the halal seal is the only filled solid green in the system (RULE H-1, lint L-4); semantic success is tint-only." },
      { "a": "{color.halal.certified.tint}", "b": "{color.success.50}", "measured": 1.06, "verdict": "Indistinguishable. Success tints never carry a shield glyph and never appear inside HalalCertificationPanel; the panel's tint is always accompanied by the seal and the certifying body's name." },
      { "a": "{color.brand.500}", "b": "{color.warning.600}", "measured": 3.23, "verdict": "OK -- warning is orange (~hue 28), brand is yellow (~hue 44). Deliberately decoupled so the two ambers are never confused." }
    ]
  }
}
