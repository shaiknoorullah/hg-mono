{
  "name": "@hg/emails",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HalalGoes transactional email templates, written with React Email and exported to static HTML and plain text with {{.Placeholder}} slots that the Go service fills with html/template. No Node at runtime.",
  "scripts": {
    "build": "tsx src/export.ts",
    "build:check": "tsx src/export.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "true"
  },
  "dependencies": {
    "@hg/ui-web": "workspace:*",
    "@react-email/components": "1.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
