{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Halal Goes — shared design-token foundation (DTCG draft format). Source of truth for the Crimson visual direction: derived verbatim from docs/design/reference/customer-home.html (--primary #C1272D, --seal #0A5233, warm neutrals, one radius language, Plus Jakarta Sans) plus the motion and iconography decisions in docs/design/01-foundations.md §7 and §11. This is the package @hg/design-tokens consumes to emit the Tailwind preset, the NativeWind preset, CSS custom properties and the typed TS export. Never hand-copy a value out of this file — always resolve it through the generator.",

  "color": {
    "$type": "color",
    "$description": "Two-tier: `primitive` is the raw palette lifted from customer-home.html :root: (light values, dark override alongside). `semantic` aliases primitive by role so components never reference a raw hex.",

    "primitive": {
      "primary":     { "light": { "$value": "#C1272D" }, "dark": { "$value": "#C1272D" } },
      "primary2":    { "light": { "$value": "#9E1E23" }, "dark": { "$value": "#9E1E23" } },
      "tint":        { "light": { "$value": "#FBE7E4" }, "dark": { "$value": "#3A1614" } },
      "on":          { "light": { "$value": "#FFFFFF" }, "dark": { "$value": "#FFFFFF" } },
      "canvas":      { "light": { "$value": "#F5F0EC" }, "dark": { "$value": "#151210" } },
      "card":        { "light": { "$value": "#FFFFFF" }, "dark": { "$value": "#1F1B17" } },
      "ink":         { "light": { "$value": "#231A17" }, "dark": { "$value": "#F2ECE7" } },
      "ink2":        { "light": { "$value": "#877A74" }, "dark": { "$value": "#9C9089" } },
      "ink3":        { "light": { "$value": "#B7ABA4" }, "dark": { "$value": "#6B625B" } },
      "hair":        { "light": { "$value": "#ECE3DD" }, "dark": { "$value": "#2E2823" } },
      "promo":       { "light": { "$value": "#D81E6A" }, "dark": { "$value": "#D81E6A" } },
      "seal":        { "light": { "$value": "#0A5233" }, "dark": { "$value": "#0A5233" }, "$description": "Halal certified. RULE H-1: the only filled-solid green surface in the system." },
      "seal2":       { "light": { "$value": "#12784A" }, "dark": { "$value": "#12784A" } },
      "sealTint":    { "light": { "$value": "#E6F1EB" }, "dark": { "$value": "#12261D" } },
      "sealLine":    { "light": { "$value": "#C8E4D6" }, "dark": { "$value": "#1E4635" } },
      "ring":        { "light": { "$value": "#F3ECDE" }, "dark": { "$value": "#F3ECDE" } },
      "link":        { "light": { "$value": "#1F6FEB" }, "dark": { "$value": "#1F6FEB" } },
      "rate":        { "light": { "$value": "#1E2A22" }, "dark": { "$value": "#0F1712" } },
      "amber":       { "light": { "$value": "#8A5A00" }, "dark": { "$value": "#8A5A00" } },
      "page":        { "light": { "$value": "#E7DED7" }, "dark": { "$value": "#0C0A09" } }
    },

    "semantic": {
      "brand":        { "fill": "{color.primitive.primary}", "fillPressed": "{color.primitive.primary2}", "onFill": "{color.primitive.on}", "tint": "{color.primitive.tint}" },
      "halal": {
        "$description": "RULE H-3: never red for a halal state. Expired is cool slate, never a warning colour.",
        "seal": "{color.primitive.seal}", "sealPressed": "{color.primitive.seal2}", "onSeal": "{color.primitive.on}",
        "tint": "{color.primitive.sealTint}", "line": "{color.primitive.sealLine}", "ring": "{color.primitive.ring}"
      },
      "surface":      { "canvas": "{color.primitive.canvas}", "card": "{color.primitive.card}", "page": "{color.primitive.page}" },
      "text":         { "primary": "{color.primitive.ink}", "secondary": "{color.primitive.ink2}", "tertiary": "{color.primitive.ink3}", "link": "{color.primitive.link}" },
      "border":       { "hairline": "{color.primitive.hair}" },
      "promo":        { "fill": "{color.primitive.promo}" },
      "rating":       { "fill": "{color.primitive.rate}" },
      "warning":      { "text": "{color.primitive.amber}" }
    }
  },

  "radius": {
    "$type": "dimension",
    "$description": "One radius language across the whole system — customer-home.html comment: 'cards, tiles, inputs, sheets, offers, buttons' / 'small chips, badges, inner boxes' / 'nav pill, chips-as-pills, halal badge'.",
    "md":   { "$value": "16px" },
    "sm":   { "$value": "11px" },
    "pill": { "$value": "999px" }
  },

  "typography": {
    "$description": "Plus Jakarta Sans (family token `PJS` in the reference prototype), one UI family. Sizes are the literal px values used across customer-home.html components, named by the smallest role that first needs them.",
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["Plus Jakarta Sans", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 },
      "extrabold":{ "$value": 800 }
    },
    "fontSize": {
      "$type": "dimension",
      "2xs":  { "$value": "10px",   "$description": "rn/badge micro-labels" },
      "xs":   { "$value": "11px",   "$description": "meta text, floor for decision-critical copy per 01-foundations §3" },
      "sm":   { "$value": "12.5px", "$description": "chips, section subtitle" },
      "base": { "$value": "13px",   "$description": "body / stat bar" },
      "md":   { "$value": "14.5px", "$description": "search field" },
      "lg":   { "$value": "16px",   "$description": "location line, restaurant card name" },
      "xl":   { "$value": "16.5px", "$description": "section heading" },
      "2xl":  { "$value": "21px",   "$description": "offer big number" },
      "3xl":  { "$value": "28px",   "$description": "splash wordmark" }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tight":  { "$value": "-0.02em" },
      "tighter":{ "$value": "-0.03em" }
    }
  },

  "motion": {
    "$description": "Verbatim from docs/design/01-foundations.md §7. Durations in ms, easings as cubic-bezier control points (also usable as CSS strings and as RN Reanimated Easing.bezier(...) args).",
    "duration": {
      "$type": "number",
      "instant":    { "$value": 75,  "$description": "press state, checkbox tick" },
      "fast":       { "$value": 120, "$description": "hover, chip toggle, tooltip" },
      "base":       { "$value": 180, "$description": "default — most enter/exit" },
      "moderate":   { "$value": 240, "$description": "sheet, dropdown, toast" },
      "slow":       { "$value": 320, "$description": "modal, screen transition" },
      "deliberate": { "$value": 480, "$description": "StatusTimeline step advance; halal seal first reveal" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":    { "$value": [0.2, 0, 0, 1],    "$description": "default both-ways" },
      "decelerate":  { "$value": [0, 0, 0, 1],       "$description": "entering" },
      "accelerate":  { "$value": [0.3, 0, 1, 1],     "$description": "exiting" },
      "emphasized":  { "$value": [0.2, 0, 0, 1.05],  "$description": "sheet arrival, seal reveal (tiny overshoot)" },
      "linear":      { "$value": [0, 0, 1, 1],       "$description": "countdowns and progress only — never ease a deadline" }
    }
  },

  "icon": {
    "$description": "Solar icon set (linear = inactive/default, bold = active/selected) per docs/design/01-foundations.md §11. The halal shield stays a bespoke asset — never sourced from this set.",
    "size": {
      "$type": "dimension",
      "sm":  { "$value": "16px" },
      "md":  { "$value": "20px" },
      "lg":  { "$value": "24px" },
      "xl":  { "$value": "32px" },
      "2xl": { "$value": "48px" }
    },
    "strokeWidth": {
      "$type": "number",
      "sm":     { "$value": 1.75 },
      "default":{ "$value": 2 }
    }
  }
}
