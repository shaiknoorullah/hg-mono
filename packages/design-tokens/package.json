{
  "name": "@hg/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared design-token + theme foundation (Crimson visual direction): DTCG source, Tailwind v4 theme, NativeWind/Tailwind v3 preset, Solar icon setup, motion tokens.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./motion": "./src/motion/index.ts",
    "./icons": "./src/icons/index.ts",
    "./icons/web": "./src/icons/Icon.tsx",
    "./icons/native": "./src/icons/Icon.native.tsx",
    "./tailwind-preset": "./src/generated/tailwind.preset.cjs",
    "./tokens.css": "./src/generated/tokens.css",
    "./theme.css": "./src/generated/theme.css"
  },
  "scripts": {
    "generate:tokens": "node scripts/generate.mjs",
    "generate:tokens:check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "true"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native-svg": "*"
  },
  "peerDependenciesMeta": {
    "react-native-svg": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "react": "19.1.0",
    "typescript": "^5.9.0"
  }
}
