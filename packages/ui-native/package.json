{
  "name": "@hg/ui-native",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./navigation": "./src/navigation/index.ts",
    "./feedback": "./src/feedback/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./preset": "./src/tokens/generated/nativewind-preset.cjs",
    "./lint": "./src/lint/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint --config src/lint/eslint.config.mjs .",
    "generate:tokens": "tsx src/tokens/generate.ts",
    "generate:tokens:check": "pnpm generate:tokens && git diff --exit-code -- ./src/tokens/generated"
  },
  "dependencies": {
    "@hg/api-client": "workspace:*"
  },
  "peerDependencies": {
    "expo-clipboard": "*",
    "nativewind": ">=4.1.0",
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "react-native-maps": ">=1.20.0",
    "react-native-safe-area-context": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "expo-clipboard": { "optional": true },
    "nativewind": { "optional": true },
    "react-native-maps": { "optional": true },
    "react-native-safe-area-context": { "optional": true }
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@react-native/babel-preset": "^0.81.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
