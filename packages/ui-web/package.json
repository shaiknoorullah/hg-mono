{
  "name": "@hg/ui-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./certification": "./src/certification/index.ts",
    "./content": "./src/content/index.ts",
    "./navigation": "./src/navigation/index.ts",
    "./feedback": "./src/feedback/index.ts",
    "./data": "./src/data/index.ts",
    "./lint": "./src/lint/index.ts",
    "./styles.css": "./src/styles/globals.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./theme.css": "./src/tokens/theme.css",
    "./grid-theme.css": "./src/tokens/grid-theme.css"
  },
  "scripts": {
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "generate:tokens:check": "node scripts/generate-tokens.mjs --check",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:icons:check": "node scripts/generate-icons.mjs --check",
    "lint": "tsx src/lint/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.5",
    "@hg/api-client": "workspace:*",
    "@hg/brand": "workspace:*",
    "@iconify/react": "^5.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "lucide-react": "^0.475.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.2",
    "@iconify/utils": "^2.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "^26.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "description": "HalalGoes web component library \u2014 tokens, primitives, certification, content, navigation, feedback and data tiers.",
  "sideEffects": [
    "*.css"
  ]
}
