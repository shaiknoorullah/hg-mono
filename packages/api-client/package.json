{
  "name": "@hg/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../contracts/openapi.yaml -o ./src/generated/openapi.d.ts --root-types --alphabetize && node ./scripts/brand-money.mjs",
    "generate:check": "pnpm generate && git diff --exit-code -- ./src/generated",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0"
  }
}
