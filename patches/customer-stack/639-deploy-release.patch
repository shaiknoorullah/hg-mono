diff --git a/apps/customer/.env.example b/apps/customer/.env.example
index b652610f..b2f4f691 100644
--- a/apps/customer/.env.example
+++ b/apps/customer/.env.example
@@ -9,3 +9,10 @@ EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
 # Empty = no search; the form falls back to manual entry marked "location not verified".
 # PUBLIC scopes only. Native tokens can't be URL-restricted — keep it minimal & rotate if abused.
 EXPO_PUBLIC_MAPBOX_TOKEN=
+
+# Stripe PUBLISHABLE key (pk_test_… for development, pk_live_… only in a production build), from
+# the same Stripe account and mode as the API's HG_STRIPE_SECRET_KEY. Card payment on web (Stripe.js
+# Payment Element) and native (payment sheet). Empty = no card payments: checkout says
+# "Card payments are not configured in this build" and nothing crashes. Never an sk_ key.
+# How to test with Stripe test cards: docs/playbooks/customer/card-payments.md
+EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
