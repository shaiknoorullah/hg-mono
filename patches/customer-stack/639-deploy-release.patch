@@ -267,6 +267,10 @@ HG_ADMIN_WEB_URL=http://localhost:5175
 
 # --- Stripe live payments + Connect payouts ------------------------------
 # Both empty => fake local gateway (Configured() is false). Set to go live.
+# Development: an sk_test_… key, and the customer app's EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY set
+# to the pk_test_… key of the same account. The webhook secret (whsec_…) is the endpoint's, or
+# the one `stripe listen` prints; without webhooks the order still moves on locally, when the
+# app reads its payment (docs/playbooks/customer/card-payments.md).
 HG_STRIPE_SECRET_KEY=
 HG_STRIPE_WEBHOOK_SECRET=
 # Where Stripe returns/refreshes the rider during Connect onboarding.
