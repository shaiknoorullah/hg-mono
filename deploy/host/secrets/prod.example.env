# Production's settings: the shape of prod.sops.env. Never fill this file in.
# Every variable is listed in deploy/.env.example; copy the ones production sets, fill
# them in an editor that writes only to the encrypted file:
#   sops ~/.config/halalgoes/secrets/prod.sops.env
# Ansible decrypts it on the machine that runs the playbook and writes /srv/hg/.env
# (mode 600) for the production compose file (#208). From the four entries that follow it also
# writes the secret files Postgres, Valkey, Silo and the bucket job read, in /srv/hg/secrets
# (README, "Secrets"); a run stops if one is missing. The Valkey password must be one word:
# openssl rand -hex 32.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# The API's and goose's database logins (the pgroles job creates the roles; hg_monitor's
# password is optional). They go in .env only: both images read the environment.
HG_DB_MIGRATOR_PASSWORD=
HG_DB_APP_PASSWORD=
# HG_DB_MONITOR_PASSWORD=
HG_ENV=production
# Traefik reaches the API over hg-proxy, which only the two of them join (group_vars/all.yml).
HG_TRUSTED_PROXY_CIDRS=10.88.0.0/29
# Signed upload and download links point at the public files host, through Traefik.
HG_MINIO_PRESIGN_BASE_URL=https://files.halalgoes.com
