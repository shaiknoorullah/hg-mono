# Production's settings: the shape of prod.sops.env. Never fill this file in.
# Every variable is listed in deploy/.env.example; copy the ones production sets, fill
# them in an editor that writes only to the encrypted file:
#   sops ~/.config/halalgoes/secrets/prod.sops.env
# Ansible decrypts it on the machine that runs the playbook and writes /srv/hg/.env
# (mode 600) for the production compose file (#208). Nothing else reads it.
HG_ENV=production
# Traefik reaches the API over hg-net, whose subnet group_vars/all.yml fixes.
HG_TRUSTED_PROXY_CIDRS=172.30.0.0/24
