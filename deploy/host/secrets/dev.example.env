# The dev environment's settings: the shape of dev.sops.env. Never fill this file in.
# provision.sh creates dev.sops.env with random passwords; add the TEST-mode keys with
#   sops ~/.config/halalgoes/secrets/dev.sops.env
# Dev never gets a live key: HG_ENV=staging makes the API refuse one at boot.
HG_ENV=staging
HG_LOG_LEVEL=debug
HG_CORS_ALLOWED_ORIGINS=https://admin.dev.halalgoes.com,https://restaurant.dev.halalgoes.com

# Dev's own data services, reachable only on the dev network.
POSTGRES_USER=hg
POSTGRES_PASSWORD=
POSTGRES_DB=hg
REDIS_PASSWORD=
MINIO_ROOT_USER=hgdev
MINIO_ROOT_PASSWORD=

HG_OTP_PEPPER=
HG_AUTH_SIGNING_KEY_SEED=
HG_APP_DATA_KEY=

# Test-mode credentials only.
HG_OTP_PROVIDER=twilio_verify
HG_TWILIO_ACCOUNT_SID=
HG_TWILIO_AUTH_TOKEN=
HG_TWILIO_VERIFY_SERVICE_SID=
HG_TWILIO_VERIFY_CHANNEL=sms
HG_STRIPE_SECRET_KEY=
HG_STRIPE_WEBHOOK_SECRET=
HG_STRIPE_CONNECT_RETURN_URL=https://restaurant.dev.halalgoes.com/payouts/return
HG_STRIPE_CONNECT_REFRESH_URL=https://restaurant.dev.halalgoes.com/payouts/refresh
# Mapbox and Resend test keys go here under the names the API reads, once #57 and #59 land.
