# Managed by Ansible (deploy/host/roles/monitoring). Security auditing: AIDE, Lynis, backups' restore drill.
groups:
  - name: security
    rules:
{% raw %}
      - alert: AideChangesDetected
        expr: hg_aide_changes_detected == 1
        for: 5m
        annotations:
          summary: "AIDE found changed system files on {{ $labels.host }}"
          description: "Read /var/log/aide/check-*.log. If the change is expected (a package update), accept it: sudo hg-aide-accept."
      - alert: AideCheckBroken
        expr: hg_aide_last_run_success == 0 or time() - hg_aide_last_run_timestamp_seconds > 2 * 86400
        for: 1h
        annotations:
          summary: "The daily AIDE check failed or has not run for 2 days on {{ $labels.host }}"
      - alert: LynisWarnings
        expr: hg_lynis_warnings > 0
        for: 1h
        annotations:
          summary: "Lynis reports {{ $value }} warning(s) on {{ $labels.host }}"
          description: "See /var/log/lynis/summary.txt and report-latest.dat."
      - alert: LynisStale
        expr: time() - hg_lynis_last_run_timestamp_seconds > 10 * 86400
        annotations:
          summary: "The weekly Lynis audit has not run for 10 days on {{ $labels.host }}"
{% endraw %}
