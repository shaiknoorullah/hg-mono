# Managed by Ansible (deploy/host/roles/monitoring).
global:
  scrape_interval: 30s

scrape_configs:
  - job_name: node
    static_configs:
{% for host in groups['hg_servers'] | default([inventory_hostname]) %}
{% if hostvars[host].hg_wg_address is defined %}
      - targets: ["{{ hostvars[host].hg_node_exporter_listen | default(hostvars[host].hg_wg_address ~ ':9100') }}"]
        labels: {host: {{ host }}}
{% endif %}
{% endfor %}
  - job_name: postgres
    static_configs: [{targets: ["postgres-exporter:9187"]}]
  - job_name: victoriametrics
    static_configs: [{targets: ["victoriametrics:8428"]}]
  - job_name: vmalert
    static_configs: [{targets: ["vmalert:8880"]}]
  - job_name: alertmanager
    static_configs: [{targets: ["alertmanager:9093"]}]
  - job_name: gatus
    static_configs: [{targets: ["gatus:8080"]}]
  - job_name: victorialogs
    static_configs: [{targets: ["victorialogs:9428"]}]
  - job_name: fluent-bit
    metrics_path: /api/v2/metrics/prometheus
    static_configs: [{targets: ["fluent-bit:2020"]}]
