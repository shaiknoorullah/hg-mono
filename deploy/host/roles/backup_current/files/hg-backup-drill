#!/bin/bash
# Managed by Ansible (deploy/host/roles/backup_current). Restore drill: load the newest dump into a
# throwaway Postgres (no network, memory-capped, removed on exit) and compare row counts with the
# live database for a few tables. A table with more rows live than in the dump is normal (the app
# kept writing); fewer live than dumped, or any missing, fails.   hg-backup-drill [--no-metrics]
set -euo pipefail
# shellcheck source=/dev/null
. /etc/hg/backup-current.conf
name=hg-restore-drill
dir=$HG_BACKUP_ROOT/pg
db=$(find "$dir" -maxdepth 1 -name 'db-*.sql.gz' | sort | tail -1)
glob=$(find "$dir" -maxdepth 1 -name 'globals-*.sql.gz' | sort | tail -1)
image=$(docker inspect --format '{{.Config.Image}}' "$HG_POSTGRES")
echo "drill: $db with $image"
pw=drill-$RANDOM$RANDOM
docker run -d --rm --name "$name" --network none --memory 768m --cpus 1 -e POSTGRES_PASSWORD="$pw" -e POSTGRES_USER=postgres "$image" >/dev/null
trap 'docker stop -t 2 "$name" >/dev/null 2>&1 || true' EXIT
for _ in $(seq 60); do docker exec "$name" pg_isready -U postgres -h /var/run/postgresql >/dev/null 2>&1 && break; sleep 2; done
# the entrypoint restarts the server once after init; wait for it to settle
sleep 4; for _ in $(seq 30); do docker exec "$name" psql -U postgres -Atc 'select 1' >/dev/null 2>&1 && break; sleep 2; done
live_db=$(docker exec "$HG_POSTGRES" sh -c 'echo "$POSTGRES_DB"')
docker exec "$name" psql -U postgres -qc "create database \"$live_db\"" >/dev/null
zcat "$glob" | grep -v '^\(CREATE\|ALTER\|DROP\) ROLE postgres' | docker exec -i "$name" psql -U postgres -q -v ON_ERROR_STOP=0 >/dev/null 2>&1 || true
zcat "$db" | docker exec -i "$name" psql -U postgres -q -d "$live_db" -v ON_ERROR_STOP=0 >/dev/null 2>/var/log/hg-backup-drill.err || true
fail=0
for t in $HG_DRILL_TABLES; do
  live=$(docker exec "$HG_POSTGRES" sh -c "psql -U \"\$POSTGRES_USER\" -d \"\$POSTGRES_DB\" -Atc 'select count(*) from public.\"$t\"'" 2>/dev/null) || { echo "  $t: not in live database, skipped"; continue; }
  rest=$(docker exec "$name" psql -U postgres -d "$live_db" -Atc "select count(*) from public.\"$t\"" 2>/dev/null || echo missing)
  if [ "$rest" = missing ] || [ "$rest" -gt "$live" ]; then verdict=FAIL; fail=1; else verdict=ok; fi
  echo "  $t: restored=$rest live=$live $verdict"
done
[ "$fail" -eq 0 ] && echo "drill: PASSED" || echo "drill: FAILED (restore errors: /var/log/hg-backup-drill.err)"
if [ "${1:-}" != --no-metrics ]; then
  { echo "hg_backup_last_run_success{backup=\"restore-drill\"} $((1 - fail))"
    [ "$fail" -ne 0 ] || echo "hg_backup_last_success_timestamp_seconds{backup=\"restore-drill\"} $(date +%s)"
  } > "$HG_TEXTFILE_DIR/hg_backup_drill.prom"
fi
exit "$fail"
