# Managed by Ansible (deploy/host/roles/ssh).
# sshd keeps the first value it reads for each setting, and this file is read first, before
# cloud-init's 50-cloud-init.conf. Check the result with: sudo sshd -T
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey
PermitEmptyPasswords no
MaxAuthTries 3
LoginGraceTime 30
X11Forwarding no
AllowAgentForwarding no
# Local forwarding stays on for "ssh -L 9001:127.0.0.1:9001", the way to Silo's console.
AllowTcpForwarding local
PermitTunnel no
ClientAliveInterval 300
ClientAliveCountMax 2
{% if hg_ssh_public %}
# TEMPORARY, until the owner's WireGuard tunnel works: the admin account from any address.
AllowUsers {{ hg_admin_user }} {{ hg_pull_user }}@{{ hg_wg_subnet }}
{% else %}
# Logins only from WireGuard peers, even if the firewall were gone.
AllowUsers {{ hg_admin_user }}@{{ hg_wg_subnet }} {{ hg_pull_user }}@{{ hg_wg_subnet }}
{% endif %}
