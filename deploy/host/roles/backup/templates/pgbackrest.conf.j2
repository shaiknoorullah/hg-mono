# Managed by Ansible (deploy/host/roles/backup).
# pgBackRest for the production Postgres. The production compose file (#208) mounts this
# folder at /etc/pgbackrest, read-only, into the Postgres container; the scheduled backups
# run beside it (hg-pgbackrest). The encryption passphrase is not here: it reaches
# pgBackRest as PGBACKREST_REPO1_CIPHER_PASS from cipher.env, readable by root only.
[global]
repo1-path=/var/lib/pgbackrest
repo1-cipher-type=aes-256-cbc
repo1-retention-full-type=time
repo1-retention-full=35
repo1-bundle=y
compress-type=zst
compress-level=3
process-max=1
start-fast=y
archive-async=y
spool-path=/var/spool/pgbackrest
# If WAL cannot be archived, queue at most 4 GiB before dropping it (and alerting), so the
# disk never fills. A drop breaks point-in-time recovery until the next backup.
archive-push-queue-max=4GiB
log-path=/var/log/pgbackrest
log-level-console=info
log-level-file=info

[{{ hg_pgbackrest_stanza }}]
pg1-path=/var/lib/postgresql/data
pg1-socket-path=/var/run/postgresql
pg1-user={{ hg_postgres_superuser }}
