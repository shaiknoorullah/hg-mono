# Umami — deploy/umami/.env
#
#   cp .env.example .env
# then generate the three secrets below. The stack refuses to boot without them
# rather than falling back to a default, because a shared APP_SECRET means
# anyone who has read the same tutorial can mint a valid session token.

# The hostname Traefik routes to. Must be a subdomain of the SITE'S OWN apex.
# analytics.halalgoes.com is first-party to halalgoes.com; a *.contabo or a bare
# IP is third-party, which is what blocklists key on and most of why you are
# self-hosting at all.
UMAMI_HOST=analytics.halalgoes.com

# openssl rand -hex 32
UMAMI_APP_SECRET=
# openssl rand -hex 32   (64 hex characters; required, used for 2FA secrets)
UMAMI_TWO_FACTOR_KEY=
# openssl rand -base64 24   (no @ / : / # — they break the DATABASE_URL)
UMAMI_POSTGRES_PASSWORD=

# Pin it. See the comment on the image line in docker-compose.yml.
UMAMI_IMAGE_TAG=latest

# The tracker is served at /<name>.js and events POST to the collect endpoint.
# Change both to anything that is not `script.js` and `/api/send`, which are
# what the blocklists match on.
UMAMI_TRACKER_SCRIPT_NAME=hg
UMAMI_COLLECT_ENDPOINT=/api/hg-collect

# Defaults are fine.
UMAMI_POSTGRES_USER=umami
UMAMI_POSTGRES_DB=umami
UMAMI_DISABLE_TELEMETRY=1

# Only read by docker-compose.tls.yml. Must match the certresolver name you add
# to the product stack's Traefik.
UMAMI_CERT_RESOLVER=letsencrypt
