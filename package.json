{
  "name": "hg-mono",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "lefthook install || echo 'lefthook: git hooks not installed (not a git checkout?)'",
    "generate":"pnpm --filter @hg/api-client generate",
    "generate:check": "pnpm generate && git diff --exit-code -- packages/api-client/src/generated",
    "generate:tokens": "pnpm -r generate:tokens",
    "generate:tokens:check": "pnpm -r generate:tokens:check",
    "emails:build": "pnpm --filter @hg/emails build",
    "emails:check": "pnpm --filter @hg/emails build:check",
    "validate:contract": "pnpm --filter @hg/contract-tools validate:contract",
    "validate:fixtures": "pnpm --filter @hg/contract-tools validate:fixtures",
    "fixtures:build": "pnpm --filter @hg/contract-tools fixtures:build",
    "mock": "pnpm --filter @hg/mock-server start",
    "e2e:missions:check": "node tools/e2e/native/routes/build-routes.mjs --check && node tools/e2e/native/check-missions.mjs && node --test tools/e2e/reality/apply-mission.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm validate:contract && pnpm validate:fixtures && pnpm generate:check && pnpm generate:tokens:check && pnpm emails:check && pnpm lint && pnpm typecheck && pnpm check:backend",
    "check:backend": "cd services/hg && make check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "coverage": "node .github/scripts/coverage.mjs collect",
    "coverage:check": "node .github/scripts/coverage.mjs check",
    "coverage:update-baseline": "node .github/scripts/coverage.mjs update-baseline"
  },
  "devDependencies": {
    "lefthook": "2.1.14",
    "playwright": "1.50.1"
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3"
  }
}
