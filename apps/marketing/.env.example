# The launch countdown. See docs/planning/marketing-site-plan.md §9.
#
# UNSET (the default) renders NO countdown — the chip above the headline reads
# "Ontario · launching soon". Forgetting to set this therefore yields no
# countdown, never a wrong one.
#
# It deliberately does NOT fall back to a waitlist counter: a signup count is on
# the do-not-publish list until it can be read live from the database, and an
# invented number on a page whose whole claim is honesty about numbers would be
# the worst place to start.
#
# A date in the past switches to the live state rather than counting negative.
# An unparseable value is treated as unset and logs a warning outside production.
#
# RFC 3339, e.g. 2026-11-03T12:00:00-05:00
NEXT_PUBLIC_LAUNCH_AT=

# Where a waitlist signup is POSTed as JSON. UNSET means nothing is stored, and
# the form shows its error state rather than reporting a success it did not
# have. See src/lib/waitlist-store.ts.
WAITLIST_WEBHOOK_URL=

# --- SEO -------------------------------------------------------------------
# The canonical origin, read at BUILD time (NEXT_PUBLIC_* is inlined, not read
# at runtime — changing it needs a redeploy). Every canonical tag, Open Graph
# URL and sitemap entry is built from it.
#
# Leave it UNSET on preview deploys: the build then uses Vercel's own host for
# that deploy, and robots.txt disallows the whole origin. Indexing is allowed
# only when Vercel says production AND it is a production build AND the origin
# is https://halalgoes.com — "forgot to set this" must not read as production.
NEXT_PUBLIC_SITE_URL=https://halalgoes.com

# --- Analytics (Umami, self-hosted) ----------------------------------------
# Both must be set or no tag is rendered at all. The tag ships inert
# (type="text/plain") and only runs once someone consents to measurement.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- CMS (Keystatic) -------------------------------------------------------
# UNSET = local storage: the editor at /keystatic writes to the working tree.
# That is right for `pnpm dev` and wrong for a public origin, so the route
# returns 404 in production until these are set.
#
# Set them and the editor switches to GitHub mode: contributors sign in with
# GitHub and their edits land as real commits by them. Create the GitHub App at
# https://github.com/settings/apps — callback URL <origin>/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
