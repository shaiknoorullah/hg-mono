# @hg/restaurant — Vite operator app. Copy to `.env.local` and fill in.
# `.env.local` is gitignored; this `.env.example` is committed — never put a real secret here.

# Backend API base (through Traefik). Prod: your API origin.
VITE_API_BASE_URL=http://localhost:8080

# Mapbox PUBLIC token (pk.…): address search on the business profile (Geocoding v6 over fetch).
# Empty = no search; the form falls back to manual entry marked "location not verified".
# The same token draws the live "rider approaching" map on accepted orders; empty = the map's
# empty state, and the rider's name and pickup time still show.
VITE_MAPBOX_TOKEN=

# Realtime socket override for local development, e.g. ws://localhost:4010/v1/ws against the
# mock. Empty = the ticket's websocket_url, or {VITE_API_BASE_URL}/v1/ws.
VITE_WS_URL=
