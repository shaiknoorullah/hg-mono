{
  "name": "@hg/restaurant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Restaurant operator web app — onboarding, live order queue, menu, hours.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:dev": "node ../../scripts/release/app-env.cjs dev -- vite build",
    "build:prod": "node ../../scripts/release/app-env.cjs prod -- vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "../../packages/ui-web/node_modules/.bin/tsx ../../packages/ui-web/src/lint/run.ts src",
    "test": "vitest run"
  },
  "dependencies": {
    "@hg/api-client": "workspace:*",
    "@hg/ui-web": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "mapbox-gl": "^3.9.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "^26.1.0",
    "openapi-fetch": "^0.17.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
