# @hg/rider — Expo app. Copy to `.env` and fill in.
# EXPO_PUBLIC_* vars are embedded in the client bundle at build time — PUBLIC values only,
# NEVER a secret (`sk.…` tokens, API secret keys, etc. must never appear here).

# Backend API base.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Mapbox PUBLIC token (pk.…), used once native maps are wired (needs an Expo dev build).
# PUBLIC scopes only. Native tokens can't be URL-restricted — keep it minimal & rotate if abused.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Mapbox SECRET downloads token (sk.… with DOWNLOADS:READ), read by the @rnmapbox/maps config
# plugin (app.json) at prebuild time, via the RNMAPBOX_MAPS_DOWNLOAD_TOKEN env var it looks for
# (not an app.json plugin prop — that form is deprecated) to fetch the native SDK.
# NEVER put this in EXPO_PUBLIC_* — it is not bundled, and does not belong in this file either.
# Set it as an EAS secret instead:
#   eas secret:create --name RNMAPBOX_MAPS_DOWNLOAD_TOKEN --value sk...
# (or export RNMAPBOX_MAPS_DOWNLOAD_TOKEN locally before a bare `expo prebuild`).
