# @hg/admin — Vite web console. Copy to `.env.local` and fill in.
# `.env.local` is gitignored; this `.env.example` is committed — never put a real secret here.

# Backend API base (through Traefik). Prod: your API origin.
VITE_API_BASE_URL=http://localhost:8080

# Mapbox PUBLIC token (pk.…) for the live maps: order detail and the live operations map.
# Create at https://account.mapbox.com/access-tokens with PUBLIC scopes ONLY
# (STYLES:TILES, STYLES:READ, FONTS:READ, DATASETS:READ, VISION:READ) — no secret scopes.
# URL-restrict this (web) token to your admin origins. See RELEASING.md.
VITE_MAPBOX_TOKEN=

# Realtime socket override for local development, e.g. ws://localhost:4010/v1/ws against the
# mock. Empty = the ticket's websocket_url, or {VITE_API_BASE_URL}/v1/ws.
VITE_WS_URL=
