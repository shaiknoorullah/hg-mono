---
/**
 * One label/value row of a certification record.
 *
 * This is the page's signature type device. It is set in mono because it should
 * read as *recorded* rather than written — and because a competitor with no
 * records to print cannot copy it. It is a type decision, not an effect, so it
 * survives every viewport and works with JavaScript off.
 *
 * A row with no `value` renders a ruled blank, not an empty string: on the
 * specimen card we are demonstrating the shape of a record we keep, and a dotted
 * rule says "a value goes here" where a plausible fake value would be a lie.
 */
interface Props {
  label: string;
  /** Omit to render a ruled blank (the specimen state). */
  value?: string;
  /** Width of the blank rule, in ch. Varied per field so it reads as a form. */
  blank?: number;
  /** Set the value in the body face instead of mono — for prose, not evidence. */
  prose?: boolean;
}
const { label, value, blank = 16, prose = false } = Astro.props;
---
<div class="rl">
  <dt class="rl-label">{label}</dt>
  <dd class:list={['rl-value', prose && 'rl-value--prose']}>
    {value ? value : <span class="rl-blank" style={`--ch:${blank}`} aria-label="not filled in"></span>}
  </dd>
</div>

<style>
  .rl {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 14px;
    align-items: baseline;
    padding-block: 7px;
  }
  .rl-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    line-height: 1.5;
  }
  .rl-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: .02em;
    line-height: 1.5;
    color: var(--text-primary);
    font-variant-numeric: var(--numeric-tabular);
    overflow-wrap: anywhere;
  }
  .rl-value--prose {
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0;
    color: var(--text-secondary);
  }

  /* A ruled blank, not an underscore run — underscores read as a broken string. */
  .rl-blank {
    display: inline-block;
    width: calc(var(--ch) * 1ch);
    max-width: 100%;
    height: 1px;
    vertical-align: .32em;
    border-top: 1px dotted var(--border-interactive);
    opacity: .55;
  }

  @media (max-width: 420px) {
    .rl { grid-template-columns: 84px minmax(0, 1fr); gap: 10px; }
    .rl-value { font-size: 12px; }
  }
</style>
