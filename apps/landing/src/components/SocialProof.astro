---
import Icon from './Icon.astro';
const DISHES = [
  { img: '/img/biryani.jpg', label: 'Biryani' },
  { img: '/img/shawarma.jpg', label: 'Shawarma' },
  { img: '/img/grill.jpg', label: 'Grill' },
  { img: '/img/curry.jpg', label: 'Curry' },
  { img: '/img/kebab.jpg', label: 'Kebab' },
  { img: '/img/platter.jpg', label: 'Platters' },
];
const AREAS = ['Scarborough', 'Mississauga', 'Markham', 'Brampton', 'North York', 'Ottawa'];
---
<section class="proof">
  <div class="container">
    <div class="proof-head">
      <div>
        <span class="eyebrow" data-reveal>What’s on the way</span>
        <h2 class="mkt-h2 aud-eat" data-reveal>Halal food, from kitchens you can trust</h2>
        <h2 class="mkt-h2 aud-own" data-reveal>Reach halal diners across the GTA</h2>
      </div>
      <p class="proof-sub aud-eat" data-reveal>Biryani, shawarma, curries, grills — every kitchen certified before it reaches your feed.</p>
      <p class="proof-sub aud-own" data-reveal>Get your storefront in front of diners who choose by the badge, in the cities we’re opening first.</p>
    </div>

    <div class="gallery">
      {DISHES.map((d) => (
        <figure class="dish lift" data-reveal>
          <img src={d.img} alt={`${d.label} — halal`} loading="lazy" width="360" height="360" />
          <figcaption>{d.label}</figcaption>
        </figure>
      ))}
    </div>

    <div class="coverage" data-reveal>
      <div class="coverage-lead">
        <Icon name="map-pin" size="md" color="var(--color-brand-500)" />
        <div>
          <div class="coverage-title">Launching across the Greater Toronto Area</div>
          <div class="coverage-note">Ontario first. Join the waitlist with your city and we’ll tell you the day we reach it.</div>
        </div>
      </div>
      <div class="areas">
        {AREAS.map((a) => <span class="area">{a}</span>)}
        <span class="area area--more">+ your city</span>
      </div>
    </div>
  </div>
</section>

<style>
  .proof { background: var(--surface-base); padding: clamp(64px,8vw,96px) 0; }
  .proof-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: 28px; }
  .proof-head .eyebrow { color: var(--color-brand-700); display: block; margin-bottom: 8px; }
  .proof-sub { margin: 0; font-size: 16px; color: var(--text-secondary); max-width: 380px; }

  .gallery { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
  .dish { position: relative; margin: 0; aspect-ratio: 1; border-radius: 16px; overflow: hidden; box-shadow: var(--elev-2); }
  .dish img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s cubic-bezier(.2,0,0,1); }
  .dish:hover img { transform: scale(1.06); }
  .dish figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 20px 12px 10px; font-size: 13px; font-weight: 700; color: #fff; background: linear-gradient(transparent, rgba(15,36,28,.72)); }

  .coverage { margin-top: 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; padding: 22px 26px; background: var(--color-neutral-100); border: 1px solid var(--border-decorative); border-radius: 20px; }
  .coverage-lead { display: flex; align-items: center; gap: 14px; }
  .coverage-title { font-size: 16px; font-weight: 700; color: var(--color-accent-600); }
  .coverage-note { font-size: 13.5px; color: var(--text-secondary); max-width: 420px; margin-top: 2px; }
  .areas { display: flex; gap: 8px; flex-wrap: wrap; }
  .area { padding: 7px 14px; background: var(--surface-raised); border: 1px solid var(--border-decorative); border-radius: var(--radius-full); font-size: 13px; font-weight: 600; color: var(--text-secondary); }
  .area--more { color: var(--color-brand-700); border-color: var(--color-brand-100); background: var(--color-brand-50); }

  @media (max-width: 900px) { .gallery { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 520px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
</style>
