---
import Icon from './Icon.astro';
const STEPS = {
  eat: [
    { icon: 'search', title: 'Browse verified restaurants', body: 'Only restaurants whose certification we have checked appear in the app.' },
    { icon: 'shopping-bag', title: 'Order in a few taps', body: 'Live prices, live kitchen hours, no surprise fees at checkout.' },
    { icon: 'bike', title: 'Sealed to your door', body: 'The restaurant seals the bag; your rider never opens it. Track it the whole way.' },
  ],
  own: [
    { icon: 'file-text', title: 'Send us your certificate', body: 'Upload the certificate and tell us who issued it. That is the whole application.' },
    { icon: 'badge-check', title: 'We verify it', body: 'An admin runs the seven-point check, usually within two working days.' },
    { icon: 'store', title: 'Go live at 0%', body: 'Your storefront opens with the badge on it, and you keep every dollar at launch.' },
  ],
};
---
<section class="hiw">
  <div class="container">
    <h2 class="mkt-h2" data-reveal>How it works</h2>
    {(['eat', 'own'] as const).map((aud) => (
      <div class:list={[`aud-${aud}`, 'grid-3', 'steps']}>
        {STEPS[aud].map((s, i) => (
          <div class="step lift" data-reveal>
            <div class="step-head">
              <span class="step-icon"><Icon name={s.icon} size="lg" /></span>
              <span class="step-n">0{i + 1}</span>
            </div>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-body">{s.body}</p>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .hiw { background: var(--surface-base); padding: clamp(64px,9vw,96px) 0; }
  .hiw .mkt-h2 { margin-bottom: 40px; }
  .steps { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
  .step { display: grid; gap: 14px; align-content: start; padding: 28px 26px; background: var(--surface-raised); border: 1px solid var(--border-decorative); border-radius: var(--radius-lg); }
  .step-head { display: flex; align-items: center; gap: 12px; }
  .step-icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--radius-md); background: var(--color-brand-50); color: var(--color-brand-700); }
  .step-n { font-size: 13px; font-weight: 700; color: var(--text-tertiary); font-variant-numeric: tabular-nums; }
  .step-title { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -.01em; color: var(--color-accent-600); }
  .step-body { margin: 0; font-size: 15px; line-height: 1.6; color: var(--text-secondary); }
</style>
