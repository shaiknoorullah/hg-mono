---
import { ICONS } from '../lib/icons';
interface Props {
  name: string;
  size?: 'sm' | 'md' | 'lg' | 'xl' | number;
  color?: string;
  strokeWidth?: number;
  class?: string;
}
const SIZES: Record<string, number> = { sm: 16, md: 20, lg: 24, xl: 32 };
const { name, size = 'md', color = 'currentColor', strokeWidth = 2, class: cls } = Astro.props;
const px = typeof size === 'number' ? size : (SIZES[size] ?? 20);
const body = ICONS[name] ?? '';
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={px}
  height={px}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={body}
></svg>
