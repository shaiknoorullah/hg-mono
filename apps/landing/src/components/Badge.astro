---
// Small pill badge (Hero eyebrow). tone="accent" = forest-tinted chrome.
import Icon from './Icon.astro';
interface Props { tone?: 'accent' | 'brand'; icon?: string; }
const { tone = 'accent', icon } = Astro.props;
---
<span class:list={['badge', `badge--${tone}`]}>
  {icon && <Icon name={icon} size="sm" />}
  <slot />
</span>

<style>
  .badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 12px; border-radius: var(--radius-full);
    font-size: 13px; font-weight: 600; letter-spacing: 0.01em; line-height: 1;
  }
  .badge--accent { background: var(--color-accent-50); color: var(--color-accent-600); border: 1px solid var(--color-accent-100); }
  .badge--brand { background: var(--color-brand-50); color: var(--color-brand-700); border: 1px solid var(--color-brand-100); }
</style>
