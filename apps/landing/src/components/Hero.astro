---
/**
 * Make them hungry, say where we are, take the address — and immediately below
 * that, hand over the artifact, so the scroll is earned rather than requested.
 *
 * The record card sits ON the photograph on purpose. Appetite and proof land in
 * the same frame, in the first screen. Opening a *food* brand with a certificate
 * makes a white paper; opening it with food alone makes another delivery app.
 *
 * Nothing on the card is invented. It is a SPECIMEN: real field labels, real
 * structure, one real organisation's name, and every identifying value left as a
 * ruled blank. On launch day it takes real props and the caption is deleted.
 */
import RecordCard from './RecordCard.astro';
import WaitlistForm from './WaitlistForm.astro';
import { ISSUERS, PLACE } from '../lib/claims';

const HERO_IMG = '/img/hero.jpg';
const hma = ISSUERS[0].name;
---
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="chip" data-reveal>
        <span class="chip-dot" aria-hidden="true"></span>
        {PLACE.province.toUpperCase()} · PRE-LAUNCH
      </p>

      <h1 class="mkt-h1" data-reveal>Order without asking.</h1>

      <p class="lede" data-reveal>
        Halal delivery across {PLACE.province}. Every kitchen here had its certificate read by a
        person — the issuer, the address it names, the date it runs out — before it was ever
        listed. So the only thing left to decide is dinner.
      </p>

      <div class="hero-form" data-reveal>
        <WaitlistForm audience="eat" context="hero" />
      </div>

      <p class="form-objection" data-reveal>
        Nothing to install — we're pre-launch. No account, no card.
      </p>
    </div>

    <div class="hero-art">
      <figure class="hero-photo">
        <img
          src={HERO_IMG}
          alt="A shared table part-way through a meal, several people reaching for the dishes"
          width="1000"
          height="1250"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <div class="hero-record" data-reveal>
        <RecordCard
          specimen
          state="certified"
          caption="Specimen · the fields we fill in before a kitchen is listed"
          issuer={hma}
          reviews="None yet. We haven't opened."
          footnote="We don't certify food and we don't make religious rulings. We read the certificate, check it, and print who issued it."
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero { background: var(--surface-base); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 64px;
    align-items: center;
    padding-top: 72px;
    padding-bottom: 120px;
  }

  .hero-copy { display: grid; justify-items: start; gap: 22px; max-width: 540px; }

  .chip {
    margin: 0; display: inline-flex; align-items: center; gap: 9px;
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: .08em; color: var(--text-tertiary);
  }
  .chip-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-halal-certified-seal);
    box-shadow: 0 0 0 2px var(--color-halal-certified-ring);
  }

  .hero-copy .lede { max-width: 46ch; color: var(--text-secondary); }
  .hero-form { width: 100%; }

  /* The photograph bleeds off the right edge of the viewport. Full strength —
     no scrim, no gradient, no zoom. If it needs a scrim to hold the type, the
     crop is wrong; fix the crop. */
  .hero-art { position: relative; }
  .hero-photo {
    margin: 0;
    aspect-ratio: 4 / 5;
    min-height: 620px;
    overflow: hidden;
    border-radius: var(--radius-marketing-md) 0 0 var(--radius-marketing-md);
    /* Bleed to the RIGHT VIEWPORT EDGE. The usual `calc(50% - 50vw)` trick is
       wrong here: this element sits in a half-width grid column, so its `50%` is
       half the column, not half the container — which overshoots the edge and
       gives the whole page a horizontal scrollbar. Measure from the container
       instead: the gap between the container's content edge and the viewport is
       half the leftover width, plus the gutter. */
    margin-right: calc(-1 * ((100vw - min(100vw, 1160px)) / 2 + 24px));
    background: var(--color-neutral-100);
  }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; }

  /* Paper resting on the table's lower-left corner. One shadow level, opaque. */
  .hero-record { position: absolute; left: -56px; bottom: -40px; width: 400px; z-index: 2; }

  @media (max-width: 1200px) {
    .hero-record { left: -24px; width: 370px; }
  }

  /* Below the split: everything stacks, and the photo is deliberately CLIPPED by
     the fold so there is a visible cut edge to scroll past. A section that ends
     flush at the fold is a false floor — the cheapest way to lose the rest. */
  @media (max-width: 899px) {
    .hero-grid { grid-template-columns: 1fr; gap: 28px; padding-top: 32px; padding-bottom: 48px; }
    .hero-copy { max-width: none; gap: 16px; }
    .hero-copy .lede { max-width: none; }
    .hero-photo {
      aspect-ratio: 3 / 2;
      min-height: 0;
      max-height: 300px;
      margin-inline: calc(50% - 50vw);
      border-radius: 0;
    }
    .hero-record { position: static; width: 100%; margin-top: 20px; }
    .hero-record :global(.rc) { max-width: none; }
  }
  @media (max-width: 639px) {
    .hero-grid { gap: 22px; padding-top: 24px; padding-bottom: 40px; }
    .hero-copy { gap: 13px; }
    .chip { font-size: 11px; }
    .hero-photo { max-height: 232px; }
  }
</style>
