---
// HalalBadge — halal_display_state = CERTIFIED. A composite {fill, ring, glyph, label},
// never a bare colour (RULE H-2). Label is the exact string "Halal certified" (C-12 R7).
import HalalShield from './HalalShield.astro';
interface Props { size?: 'sm' | 'md'; }
const { size = 'sm' } = Astro.props;
const plate = size === 'sm' ? 22 : 28;
const glyph = size === 'sm' ? 13 : 17;
---
<span class="halalbadge" style={`--plate:${plate}px`}>
  <span class="halalbadge__seal">
    <HalalShield size={glyph} color="var(--color-halal-certified-on-seal)" checkColor="var(--color-halal-certified-seal)" />
  </span>
  <span class="halalbadge__label">Halal certified</span>
</span>

<style>
  .halalbadge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px 4px 4px;
    background: var(--color-halal-certified-tint);
    border: 1px solid var(--color-halal-certified-tint-border);
    border-radius: var(--radius-full);
  }
  .halalbadge__seal {
    width: var(--plate);
    height: var(--plate);
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-halal-certified-seal);
    box-shadow: inset 0 0 0 1.5px var(--color-halal-certified-ring);
  }
  .halalbadge__label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-halal-certified-tint-text);
  }
</style>
