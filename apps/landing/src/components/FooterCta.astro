---
/**
 * Close with the identical words as the hero. One conversion, repeated verbatim,
 * is what a single-conversion page is for — a second, cleverer closing line just
 * teaches the reader they were being sold two different things.
 *
 * Cream, and left-aligned on the optical edge. A centred closing block on a page
 * where nothing else is centred is the template tell, and the forest budget is
 * already spent on the refusal, the restaurant band, and the footer below.
 */
import WaitlistForm from './WaitlistForm.astro';
import { DISCLAIMER, PLACE } from '../lib/claims';

interface Props {
  audience?: 'eat' | 'own';
  heading?: string;
  lede?: string;
}
const {
  audience = 'eat',
  // The diner close repeats the hero H1 VERBATIM. One conversion, said twice in
  // the same words, is what a single-conversion page is for.
  heading = 'Order without asking.',
  lede = "Leave your email. We'll write once, the day we open in your area — and after that, only when there's something worth telling you.",
} = Astro.props;
const year = new Date().getFullYear();
---
<section class="section--hinge ask" id="waitlist">
  <div class="container">
    <div class="ask-inner">
      <h2 class="mkt-h2" data-reveal>{heading}</h2>
      <p class="lede ask-lede" data-reveal>{lede}</p>
      <div data-reveal><WaitlistForm audience={audience} context="footer" /></div>
      <p class="form-objection ask-obj" data-reveal>
        {audience === 'eat'
          ? "Nothing to install — we're pre-launch. No account, no card."
          : 'No card and no hardware to buy. We read your certificate before anything else happens.'}
      </p>
    </div>
  </div>
</section>

<footer class="band band--deep site-foot">
  <div class="container">
    <div class="foot-top">
      <div>
        <p class="foot-mark">Halal Goes</p>
        <p class="foot-tag">Verified halal, delivered.</p>
      </div>
      <nav class="foot-links" aria-label="Footer">
        <a href="/verification">The verification standard</a>
        <a href="/for-restaurants">I own a restaurant</a>
      </nav>
    </div>
    <p class="mono foot-legal">{DISCLAIMER}</p>
    <p class="mono foot-copy">
      © {year} Halal Goes · {PLACE.province}, {PLACE.country} · Pre-launch — this page is a
      waitlist, not an app
    </p>
  </div>
</footer>

<style>
  .ask { background: var(--surface-base); }
  .ask-inner { max-width: 560px; }
  .ask-lede { margin: 16px 0 28px; color: var(--text-secondary); }
  .ask-obj { margin-top: 14px; }

  .site-foot { padding-block: 48px; }
  .foot-top {
    display: flex; flex-wrap: wrap; gap: 24px 48px;
    justify-content: space-between; align-items: flex-start;
    padding-bottom: 28px;
  }
  .foot-mark { margin: 0 0 4px; font-size: 18px; font-weight: 800; letter-spacing: -.03em; }
  .foot-tag { margin: 0; font-size: 14px; color: var(--color-accent-200); }
  .foot-links { display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .foot-links a {
    font-size: 14px; font-weight: 600; color: var(--color-neutral-50);
    border-bottom: 1px solid rgba(255, 255, 255, .28); padding-bottom: 2px;
  }
  .foot-links a:hover { border-bottom-color: var(--color-neutral-50); }

  .foot-legal {
    margin: 0 0 12px; padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, .1);
    line-height: 1.6; max-width: 70ch; color: var(--color-accent-200);
  }
  .foot-copy { margin: 0; font-size: 11px; line-height: 1.6; color: var(--color-accent-300); }
</style>
