---
/**
 * The single conversion on the site. One field, forever.
 *
 * CONSENT, and why there is no tick-box.
 *
 * There was one, and it restated the submit button word for word — "Email me
 * when Halal Goes opens in my area." under a button reading "Email me when you
 * open". Two controls, one meaning: pure friction.
 *
 * CASL needs a positive, unbundled action, and CRTC 2012-549 names two examples
 * of one: ticking a box, OR "actively entering their e-mail address in an
 * electronic form". A box is required when consent rides along with something
 * else — a checkout, a signup carrying other terms — because then the action of
 * submitting means several things at once and consent must be separable. This
 * form does exactly one thing, so typing an address and pressing a button that
 * says what will be sent IS the unbundled positive action.
 *
 * What still has to be true, and is:
 *  1. The notice sits WITH the control, states who is sending and what, and is
 *     legible — not buried in a footer or behind a link.
 *  2. Nothing is pre-agreed on the user's behalf beyond the single purpose they
 *     came here for. There is no second purpose hidden in the submit.
 *  3. The rendered consent SENTENCE is submitted with the timestamp and the
 *     method, so the artifact survives a later copy edit — "they consented" is
 *     not a defence; "they consented to this text, this way, on this date" is.
 *  4. Both audiences log it. CASL treats commercial email and SMS identically,
 *     and the restaurant path previously recorded no artifact at all.
 *
 * WHY EMAIL AND NOT A PHONE NUMBER, on a mobile-first consumer page where a
 * phone field would convert better: decision O-03 (SMS / A2P 10DLC registration)
 * is unresolved and is the longest-lead item in the project — there is no
 * approved sender today. "We'll text you at launch" is therefore a promise we
 * cannot currently keep, and an unkeepable promise is the one thing a brand
 * whose entire pitch is carefulness cannot afford. Email is deliverable now.
 * When O-03 clears this becomes a one-line switch back.
 */
import Button from './Button.astro';

interface Props {
  audience: 'eat' | 'own';
  /** Where on the page this instance sits — recorded with the submission. */
  context: string;
  id?: string;
}
const { audience, context, id } = Astro.props;
const eat = audience === 'eat';

// The consent record. This exact sentence is rendered to the user AND stored
// with the lead — they must never drift apart.
//
// It stays short but it does NOT become "you agree to our Terms". CASL wants
// consent to email unbundled from general terms, so the one thing being
// consented to has to be legible right here, at the control. The Terms and the
// Privacy Policy carry everything else.
const CONSENT = eat
  ? 'One email at launch, then only when new kitchens near you are verified.'
  : 'We email you what we check, what it costs, and how to get listed.';
const fieldId = `${context}-${audience}-input`;
const msgId = `${context}-${audience}-msg`;
---
<!--
  action/method are real, not decoration: with JavaScript off this form still
  posts to the endpoint, which accepts form-encoded bodies and answers with a
  plain confirmation page. A waitlist that silently does nothing for a visitor
  on a locked-down browser is the worst possible failure for this brand.
-->
<form
  class="waitlist-form"
  id={id}
  action="/api/waitlist"
  method="post"
  data-audience={audience}
  data-context={context}
  data-consent-text={CONSENT}
  novalidate
>
  <input type="hidden" name="audience" value={audience} />
  <input type="hidden" name="context" value={context} />
  <input type="hidden" name="consentText" value={CONSENT} />
  <input type="hidden" name="consentMethod" value="form_submit" />
  <div class="wf-row">
    <div class="field">
      <label class="field-label" for={fieldId}>{eat ? 'Email' : 'Work email'}</label>
      <input
        id={fieldId}
        type="email"
        name="email"
        inputmode="email"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder={eat ? 'you@example.com' : 'chef@yourrestaurant.ca'}
        aria-describedby={msgId}
        required
      />
    </div>
    <div class="wf-submit">
      <Button size="lg" type="submit" variant="primary" fullWidth>
        {eat ? 'Email me when you open' : 'Send me the details'}
      </Button>
    </div>
  </div>

  <p class="wf-consent">
    {CONSENT} Unsubscribe any time. By joining you agree to our
    <a href="/terms">Terms</a> and <a href="/privacy">Privacy&nbsp;Policy</a>.
  </p>

  <p class="formmsg" id={msgId} role="status" aria-live="polite"></p>
</form>

<style>
  .waitlist-form { display: grid; gap: 14px; width: 100%; max-width: 480px; }
  .wf-row { display: grid; gap: 12px; }
  .wf-submit { align-self: end; }

  /* Side by side once there is room for a 52px button without crushing the field. */
  @media (min-width: 640px) {
    .wf-row { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
    .wf-submit :global(.btn) { width: auto; padding-inline: 22px; }
  }

  .waitlist-form .form-help { margin-top: -4px; }

  /* Legible, beside the control, in the user's reading order — a consent notice
     that has to be hunted for is not a notice. */
  .wf-consent {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--text-tertiary);
    max-width: 52ch;
  }
  .wf-consent a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--border-decorative);
  }
  .wf-consent a:hover { text-decoration-color: var(--action-primary); }
</style>
