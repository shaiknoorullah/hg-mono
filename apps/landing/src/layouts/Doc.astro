---
/**
 * The document shell — /terms, /privacy and anything else that is text of
 * record. Same grammar as the verification standard: cream ground, one optical
 * left edge, mono for anything that is evidence (version, dates, headings).
 *
 * Every document rendered here is VERSIONED and DATED in the masthead, for the
 * same reason the verification standard is: if we quietly change what we
 * promise, the change should be visible.
 */
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import FooterCta from '../components/FooterCta.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  standfirst: string;
  version: string;
  effective: string;
}
const { title, description, heading, standfirst, version, effective } = Astro.props;
---
<Base title={title} description={description}>
  <Nav page="diner" />
  <main class="doc-page">
    <header class="doc-head">
      <div class="container">
        <p class="mono doc-stamp">{version} · EFFECTIVE {effective.toUpperCase()}</p>
        <h1 class="mkt-h1 doc-h1">{heading}</h1>
        <p class="lede doc-lede">{standfirst}</p>
      </div>
    </header>
    <div class="container doc-body">
      <slot />
      <p class="mono doc-foot">
        {version} · effective {effective} · Halal Goes · Ontario, Canada. This document applies to
        this website and its waitlist. It is not a contract for a delivery service — there isn't
        one yet.
      </p>
    </div>
  </main>
  <FooterCta />
</Base>

<style is:global>
  .doc-page { background: var(--surface-base); }
  .doc-head { padding-block: 64px 44px; border-bottom: 1px solid var(--border-decorative); }
  .doc-stamp { margin: 0 0 18px; }
  .doc-h1 { font-size: clamp(32px, 5vw, 52px); max-width: 18ch; }
  .doc-lede { margin-top: 18px; color: var(--text-secondary); }

  .doc-body { padding-block: 52px 80px; }
  .doc-body > section { margin-bottom: 44px; max-width: 700px; }
  .doc-body h2 {
    margin: 0 0 12px; font-size: clamp(21px, 2.8vw, 26px); font-weight: 800;
    line-height: 1.15; letter-spacing: -.02em; color: var(--text-primary);
  }
  .doc-body h2 .n {
    display: block; font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: .1em; color: var(--text-tertiary); margin-bottom: 8px;
  }
  .doc-body h3 { margin: 22px 0 6px; font-size: 17px; font-weight: 700; color: var(--text-primary); }
  .doc-body p { margin: 0 0 14px; font-size: 16px; line-height: 1.65; color: var(--text-secondary); max-width: 66ch; }
  .doc-body strong { font-weight: 700; color: var(--text-primary); }
  .doc-body a {
    color: var(--text-primary); font-weight: 600;
    text-decoration: underline; text-underline-offset: 3px;
    text-decoration-color: var(--border-decorative);
  }
  .doc-body a:hover { text-decoration-color: var(--action-primary); }

  .doc-body ul { list-style: none; margin: 0 0 16px; padding: 0; max-width: 66ch; }
  .doc-body ul li {
    position: relative; padding: 0 0 10px 22px;
    font-size: 16px; line-height: 1.6; color: var(--text-secondary);
  }
  .doc-body ul li::before {
    content: ''; position: absolute; left: 0; top: .72em;
    width: 10px; height: 1px; background: var(--text-tertiary);
  }

  /* A value we do not have yet is drawn as a ruled blank, never invented — the
     same device as the specimen record card, applied to ourselves. */
  .doc-gap { padding: 22px 24px; margin: 4px 0 0; }
  .doc-blank {
    display: inline-block; width: min(24ch, 100%); height: 1px; vertical-align: .32em;
    border-top: 1px dotted var(--border-interactive); opacity: .55;
  }

  .doc-foot { margin: 8px 0 0; max-width: 74ch; line-height: 1.7; font-size: 12px; }

  @media (max-width: 639px) {
    .doc-head { padding-block: 36px 30px; }
    .doc-body { padding-block: 36px 56px; }
    .doc-body > section { margin-bottom: 32px; }
    .doc-body p, .doc-body ul li { font-size: 15px; line-height: 1.6; }
    .doc-body h2 { font-size: 20px; }
  }
</style>
