---
/**
 * The restaurant page. Same grammar, different argument, ONE <h1>.
 *
 * The owner's subject is their certificate, not dinner — so there is no food
 * photograph here. The hero's right column is the same specimen record card,
 * captioned as the record we'd build out of the document already in their drawer.
 *
 * What is deliberately ABSENT, because none of it is decided anywhere in the
 * repo: a launch-partner programme, a promotional window, a commission-free
 * period with an end date, a notice period before rates change, "no contract",
 * "no exclusivity", a guaranteed go-live turnaround, and any refund-liability
 * split. Every one of those was proposed in creative work and every one would
 * have been invented. See src/lib/claims.ts.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import RecordCard from '../components/RecordCard.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import Checklist from '../components/Checklist.astro';
import Refusal from '../components/Refusal.astro';
import FooterCta from '../components/FooterCta.astro';
import Icon from '../components/Icon.astro';
import { ISSUERS, MONEY, PLACE } from '../lib/claims';

const title = `List your halal restaurant in ${PLACE.province} — 0% commission at launch | Halal Goes`;
const description =
  'Your halal certificate is already your best marketing. Halal Goes verifies it and puts it in front of people who order by it. Commission at launch is 0%, and nobody can pay for feed position.';

const STEPS = [
  {
    t: 'Send your certificate',
    b: 'Upload it and tell us who issued it. Alongside it we need your business licence, a provincial food-safety permit and owner ID. That is the application.',
  },
  {
    t: 'A person runs the seven checks',
    b: 'Not a scanner and not a model — someone reads the document and records the result of each check against their name. If something is missing we tell you exactly what, rather than just declining.',
  },
  {
    t: 'You go live with the record attached',
    b: 'Your storefront opens with the verified badge on it, and the badge opens into the record: the issuer, the scope, the expiry, and who checked it.',
  },
];

const RQA: [string, string][] = [
  [
    "What if my certificate is from an issuer you don't list?",
    "Send it anyway. If the issuing body is accredited and the certificate covers your kitchen, we will assess it and tell you either way, with a reason. The registry is seeded, not closed — we would rather add an issuer we can stand behind than turn away a kitchen that has done the work.",
  ],
  [
    'What does it cost me?',
    'Commission at launch is 0% and the customer service fee is set to $0.00. That is a per-restaurant setting rather than a promotion with a countdown on it, and we would rather tell you plainly that it can change than sell you an offer that expires. 100% of every tip and 100% of the delivery fee go to the rider, not to us.',
  ],
  [
    'Can I pay to rank higher?',
    'No, and there is no plan to build it. A restaurant cannot pay for or influence its position in the feed. That rule is the reason a diner has any reason to believe the list, so it is not for sale.',
  ],
  [
    'Do I need new hardware?',
    'No. A phone or any browser you already have. There is no terminal to buy, no POS integration to commission and no weekly device fee — printer and POS integrations are explicitly out of scope, not quietly pending.',
  ],
  [
    'How long does it take?',
    'We aim to review within two business days. That is an internal target we measure ourselves against, not a guarantee — and we would rather say so than print a number we might miss. Nothing is ever auto-approved when a timer runs out.',
  ],
  [
    'What happens when my certificate expires?',
    'Your listing comes down until it is renewed, and it goes back up automatically when a new certificate is approved — there is no manual reinstatement step, because the lapse is not a punishment. We warn you well before the date, more than once.',
  ],
];
---
<Base title={title} description={description}>
  <Nav page="restaurant" />
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="chip" data-reveal>
            <span class="chip-dot" aria-hidden="true"></span>
            {PLACE.province.toUpperCase()} · {MONEY.commissionAtLaunch} COMMISSION AT LAUNCH
          </p>
          <h1 class="mkt-h1" data-reveal>You paid for the certification. Start getting credit for it.</h1>
          <p class="lede" data-reveal>
            You already did the hard part — the audit, the paperwork, the renewal. On most apps
            it buys you nothing, because you are listed beside a kitchen that typed “halal” into
            a form. Here it is the entry requirement.
          </p>
          <div data-reveal><WaitlistForm audience="own" context="hero" /></div>
          <p class="form-objection" data-reveal>
            No card, no hardware, no sales call. We read your certificate first.
          </p>
        </div>

        <div class="hero-art" data-reveal>
          <RecordCard
            specimen
            state="certified"
            caption="Specimen · the record we build from the document already in your drawer"
            issuer={ISSUERS[0].name}
            footnote="Your customers can open this from your listing. It is the reason the badge means anything."
          />
        </div>
      </div>
    </section>

    <Checklist />
    <Refusal />

    <section class="section steps">
      <div class="container">
        <p class="eyebrow" data-reveal>Getting listed</p>
        <h2 class="mkt-h2" data-reveal>A certificate, a licence, and an afternoon.</h2>
        <div class="doc steps-card" data-reveal-group>
          {STEPS.map((s, i) => (
            <div class="stp" data-reveal>
              <span class="mono stp-n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="stp-t">{s.t}</p>
                <p class="stp-b">{s.b}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section faq">
      <div class="container">
        <h2 class="mkt-h2 faq-h" data-reveal>Before you ask</h2>
        <div class="faq-list" data-reveal-group>
          {RQA.map(([q, a], i) => (
            <details open={i === 0} data-reveal>
              <summary>
                <span>{q}</span>
                <Icon name="chevron-down" size="md" color="var(--text-tertiary)" class="chev" />
              </summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <FooterCta
    audience="own"
    heading="Send us the certificate."
    lede="Leave your email and we'll send what we check, what it costs, and how to get listed before we open."
  />
</Base>

<style>
  .hero { background: var(--surface-base); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 64px;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 96px;
  }
  .hero-copy { display: grid; justify-items: start; gap: 22px; max-width: 560px; }
  .hero-copy .mkt-h1 { font-size: clamp(34px, 5.2vw, 58px); }
  .hero-copy .lede { max-width: 48ch; color: var(--text-secondary); }

  .chip {
    margin: 0; display: inline-flex; align-items: center; gap: 9px;
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: .08em; color: var(--text-tertiary);
  }
  .chip-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-halal-certified-seal);
    box-shadow: 0 0 0 2px var(--color-halal-certified-ring);
  }
  .hero-art { justify-self: end; width: 100%; }

  .steps { background: var(--surface-base); }
  .steps-card { margin-top: 32px; padding: 36px 40px; max-width: 760px; }
  .stp {
    display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 16px;
    padding-block: 22px; border-top: 1px solid var(--border-decorative);
  }
  .stp:first-child { border-top: 0; padding-top: 0; }
  .stp:last-child { padding-bottom: 0; }
  .stp-n { font-size: 12px; letter-spacing: .06em; line-height: 1.7; }
  .stp-t { margin: 0 0 5px; font-size: 17px; font-weight: 700; line-height: 1.3; color: var(--text-primary); }
  .stp-b { margin: 0; font-size: 15px; line-height: 1.6; color: var(--text-secondary); max-width: 58ch; }

  .faq { background: var(--surface-base); }
  .faq-h { margin-bottom: 32px; }
  .faq-list { max-width: 720px; }
  details { border-top: 1px solid var(--border-decorative); }
  details:last-child { border-bottom: 1px solid var(--border-decorative); }
  summary {
    display: flex; align-items: flex-start; gap: 20px; padding: 20px 0;
    cursor: pointer; list-style: none;
    font-size: 17px; font-weight: 700; line-height: 1.35; color: var(--text-primary);
  }
  summary::-webkit-details-marker { display: none; }
  summary > span:first-child { flex: 1; }
  .chev { flex: 0 0 auto; margin-top: 2px; transition: transform var(--duration-base) var(--ease-standard); }
  details[open] .chev { transform: rotate(180deg); }
  details p { margin: 0; padding: 0 0 22px; font-size: 16px; line-height: 1.65; color: var(--text-secondary); max-width: 62ch; }

  @media (max-width: 899px) {
    .hero-grid { grid-template-columns: 1fr; gap: 36px; padding-top: 40px; padding-bottom: 56px; }
    .hero-copy { max-width: none; }
    .hero-art :global(.rc) { max-width: none; }
    .steps-card { padding: 24px; }
  }
</style>
