---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Verification from '../components/Verification.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Benefits from '../components/Benefits.astro';
import SocialProof from '../components/SocialProof.astro';
import Faq, { QA } from '../components/Faq.astro';
import FooterCta from '../components/FooterCta.astro';

const title = 'Halal Goes — verified halal, delivered.';
const description =
  'Every restaurant on Halal Goes is admin-verified against a seven-point halal certification check. Pre-launch in Ontario — join the waitlist.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Halal Goes',
    url: 'https://halalgoes.com',
    slogan: 'Verified halal, delivered.',
    description,
    areaServed: { '@type': 'AdministrativeArea', name: 'Ontario, Canada' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Halal Goes',
    url: 'https://halalgoes.com',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: QA.map(([q, a]) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <Nav />
  <main>
    <Hero />
    <Verification />
    <HowItWorks />
    <Benefits />
    <SocialProof />
    <Faq />
  </main>
  <FooterCta />
</Base>
