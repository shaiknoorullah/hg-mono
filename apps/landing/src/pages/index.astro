---
/**
 * The diner page. ONE <h1>, one conversion, one audience.
 *
 * The old segmented "Order food / List your restaurant" toggle is gone: it
 * rendered two heroes and two <h1>s into every DOM, and it asked a stranger to
 * classify themselves before they had read anything. Restaurateurs get a real
 * page of their own at /for-restaurants, plus a band here so nobody has to
 * self-identify to get information.
 *
 * Beat order is deliberate — appetite, belonging, explanation, permission,
 * proof, the ask. The tension beat (WhyShort) sits AFTER the food, never before
 * it: as an opener it reads as a grievance.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Recognition from '../components/Recognition.astro';
import CravingGrid from '../components/CravingGrid.astro';
import WhyShort from '../components/WhyShort.astro';
import Checklist from '../components/Checklist.astro';
import Refusal from '../components/Refusal.astro';
import StateGrid from '../components/StateGrid.astro';
import Sealed from '../components/Sealed.astro';
import Publish from '../components/Publish.astro';
import RestaurantBand from '../components/RestaurantBand.astro';
import Faq, { QA } from '../components/Faq.astro';
import FooterCta from '../components/FooterCta.astro';
import StickyCta from '../components/StickyCta.astro';
import { DISCLAIMER, PLACE } from '../lib/claims';

const title = 'Halal food delivery in Ontario — every kitchen’s certificate checked | Halal Goes';
const description =
  'Halal Goes reads the certificate before a kitchen is ever listed — the issuer, the number, the scope, the expiry, and the admin who signed off. Ontario, pre-launch. Join the waitlist.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Halal Goes',
    url: 'https://halalgoes.com',
    slogan: 'Verified halal, delivered.',
    description,
    areaServed: { '@type': 'AdministrativeArea', name: `${PLACE.province}, ${PLACE.country}` },
    disambiguatingDescription: DISCLAIMER,
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Halal Goes', url: 'https://halalgoes.com' },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: QA.map(([q, a]) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <Nav page="diner" />
  <main>
    <Hero />
    <Recognition />
    <CravingGrid />
    <WhyShort />
    <Checklist />
    <Refusal />
    <StateGrid />
    <Sealed />
    <Publish />
    <RestaurantBand />
    <Faq />
  </main>
  <FooterCta />
  <StickyCta />
</Base>
